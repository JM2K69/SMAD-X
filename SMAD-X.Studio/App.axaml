<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:SMADX.Converters"
             x:Class="SMADX.Studio.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <converters:MarkdownConverter x:Key="MarkdownConverter"/>
        <!-- Un flacon de laboratoire : l'atelier des exercices -->
        <StreamGeometry x:Key="StudioIcon">M8.5,2 L15.5,2 L15.5,4 L14.25,4 L14.25,9.2 L20.1,19.3 C20.8,20.6 19.9,22 18.4,22 L5.6,22 C4.1,22 3.2,20.6 3.9,19.3 L9.75,9.2 L9.75,4 L8.5,4 Z</StreamGeometry>
        <!-- Les icônes des outils, celles de leur propre fenêtre : l'annuaire de SMAD-X, le bouclier de SMAR-X -->
        <StreamGeometry x:Key="SmadxIcon">M9,2 L15,2 L15,7.5 L9,7.5 Z M11.25,7.5 L12.75,7.5 L12.75,10.5 L11.25,10.5 Z M4.25,10.25 L19.75,10.25 L19.75,11.75 L4.25,11.75 Z M4.25,11 L5.75,11 L5.75,15 L4.25,15 Z M11.25,11 L12.75,11 L12.75,15 L11.25,15 Z M18.25,11 L19.75,11 L19.75,15 L18.25,15 Z M2,15 L8,15 L8,21 L2,21 Z M9,15 L15,15 L15,21 L9,21 Z M16,15 L22,15 L22,21 L16,21 Z</StreamGeometry>
        <StreamGeometry x:Key="SmarxIcon">M12,2 L20,5 L20,11 C20,16 16.6,20.4 12,22 C7.4,20.4 4,16 4,11 L4,5 Z</StreamGeometry>
        <!-- Ce que fait une tuile : créer (plus) ou ouvrir (dossier) -->
        <StreamGeometry x:Key="NewIcon">M10.5,4 L13.5,4 L13.5,10.5 L20,10.5 L20,13.5 L13.5,13.5 L13.5,20 L10.5,20 L10.5,13.5 L4,13.5 L4,10.5 L10.5,10.5 Z</StreamGeometry>
        <!-- Une fiche : la page, son coin plié et deux lignes de texte -->
        <StreamGeometry x:Key="SheetIcon">F1 M6,2 L14,2 L20,8 L20,20 C20,21.1 19.1,22 18,22 L6,22 C4.9,22 4,21.1 4,20 L4,4 C4,2.9 4.9,2 6,2 Z M13,3.5 L13,9 L18.5,9 Z M7,12 L17,12 L17,13.5 L7,13.5 Z M7,16 L15,16 L15,17.5 L7,17.5 Z</StreamGeometry>
        <StreamGeometry x:Key="OpenIcon">M2,6.5 C2,5.1 3.1,4 4.5,4 L9.2,4 L11.4,6.2 L19.5,6.2 C20.9,6.2 22,7.3 22,8.7 L22,17.5 C22,18.9 20.9,20 19.5,20 L4.5,20 C3.1,20 2,18.9 2,17.5 Z</StreamGeometry>
        <LinearGradientBrush x:Key="SmadxBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#4C9AFF" Offset="0"/>
            <GradientStop Color="#2BB3A3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SmarxBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#4C9AFF" Offset="0"/>
            <GradientStop Color="#8250DF" Offset="1"/>
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SMAD-X.UI/Themes/Suite.axaml"/>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.code">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Menlo, monospace"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- Une tuile de l'accueil : l'icône de l'outil, ce qu'elle fait, en quelques mots -->
        <Style Selector="Button.tile">
            <Setter Property="Width" Value="206"/>
            <Setter Property="Height" Value="146"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipHoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <!-- Une tuile en bandeau, sur toute la largeur de sa carte : l'icône à gauche, le texte à droite -->
        <Style Selector="Button.tile.wide">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Aligné sur la grille des tuiles : 12 sous la rangée au-dessus, le bord droit sur celui de la dernière tuile -->
            <Setter Property="Margin" Value="0,-12,28,0"/>
        </Style>
        <!-- Des pastilles à choisir (les sources d'une règle) : arrondies, la choisie en couleur d'accent -->
        <Style Selector="ListBox.chips">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.chips ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.chips ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
        </Style>
        <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipHoverBg}"/>
        </Style>
        <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="ListBox.chips ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="ListBox.chips ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
    </Application.Styles>
</Application>
