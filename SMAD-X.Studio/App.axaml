<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:SMADX.Converters"
             x:Class="SMADX.Studio.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <converters:MarkdownConverter x:Key="MarkdownConverter"/>
        <!-- Un flacon de laboratoire : l'atelier des exercices -->
        <StreamGeometry x:Key="StudioIcon">M8.5,2 L15.5,2 L15.5,4 L14.25,4 L14.25,9.2 L20.1,19.3 C20.8,20.6 19.9,22 18.4,22 L5.6,22 C4.1,22 3.2,20.6 3.9,19.3 L9.75,9.2 L9.75,4 L8.5,4 Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SMAD-X.UI/Themes/Suite.axaml"/>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.code">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Menlo, monospace"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Application.Styles>
</Application>
