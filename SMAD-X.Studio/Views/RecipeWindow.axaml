<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SMADX.Studio.Views.RecipeWindow"
        Title="{Binding [Recipe.Title], Source={StaticResource S}}"
        Width="960" Height="680" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Icon="avares://SMAD-X.Studio/Assets/icone.ico">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
            <TextBlock Classes="hint" Text="{Binding [Recipe.Intro], Source={StaticResource S}}"/>
            <TextBlock Classes="hint" Text="{Binding [Recipe.Check], Source={StaticResource S}}"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding Filter}"
                     PlaceholderText="{Binding [Recipe.Filter], Source={StaticResource S}}"/>
            <Button Classes="tool" Grid.Column="1" Margin="8,0,0,0" Click="ClearChecks"
                    Content="{Binding [Recipe.ClearChecks], Source={StaticResource S}}"/>
        </Grid>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Classes="label"
                       Text="{Binding [Recipe.Language], Source={StaticResource S}}"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Width="180" ItemsSource="{Binding Cultures}" SelectedItem="{Binding Culture}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0" Classes="label"
                       Text="{Binding [Recipe.Domain], Source={StaticResource S}}"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding DomainName}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,8,0" Classes="label"
                       Text="{Binding [Recipe.Server], Source={StaticResource S}}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Width="180" Margin="0,8,0,0" ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}"/>
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <Button Classes="accent" IsDefault="True" IsEnabled="{Binding CanCreate}" Click="Create"
                        Content="{Binding [Recipe.Create], Source={StaticResource S}}"/>
                <Button Classes="tool" IsCancel="True" Click="Cancel" Content="{Binding [Recipe.Cancel], Source={StaticResource S}}"/>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource ChipBg}">
                <TextBlock TextWrapping="Wrap" Text="{Binding Selected.Situation}"/>
            </Border>
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectionSummary}"
                       IsVisible="{Binding SelectionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource DangerSoft}" IsVisible="{Binding HasIncompatibility}">
                <TextBlock TextWrapping="Wrap" Text="{Binding Incompatibility}"/>
            </Border>
        </StackPanel>

        <Border Classes="card" Padding="6">
        <ListBox Classes="plain" ItemsSource="{Binding Recipes}" SelectedItem="{Binding Selected}" DoubleTapped="Create">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="32,80,*,190,40">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0"/>
                        <Border Grid.Column="1" Background="{Binding SeverityColor}" CornerRadius="6" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RuleId}" Foreground="Black" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <!-- Le point ANSSI ouvre les fiches des sources de la règle -->
                        <Button Grid.Column="3" Classes="link" Click="ShowSources" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0"
                                ToolTip.Tip="{Binding [Recipe.Sources.Tip], Source={StaticResource S}}">
                            <TextBlock Text="{Binding Anssi}" TextTrimming="CharacterEllipsis" FontSize="14"/>
                        </Button>
                        <TextBlock Grid.Column="4" Text="{Binding Level}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Border>
    </DockPanel>
</Window>
