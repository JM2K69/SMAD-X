<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SMADX.Studio.Views"
        x:Class="SMADX.Studio.Views.MainWindow"
        x:Name="Root"
        Title="{Binding [App.Title], Source={StaticResource S}}"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="avares://SMAD-X.Studio/Assets/icone.ico">

    <DockPanel>
        <!-- En-tête : l'application et ses menus -->
        <Border DockPanel.Dock="Top" Classes="header" Padding="20,10">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#8250DF" Offset="0"/>
                                <GradientStop Color="#E85AAD" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Data="{StaticResource StudioIcon}" Width="20" Height="20" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMAD-X Studio" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Classes="muted" Text="{Binding [App.Subtitle], Source={StaticResource S}}"/>
                    </StackPanel>
                </StackPanel>
        <Menu Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
            <MenuItem Header="{Binding [Menu.File], Source={StaticResource S}}">
                <MenuItem Header="{Binding [Menu.NewFromRecipe], Source={StaticResource S}}" Command="{Binding NewFromRecipeCommand}" InputGesture="Ctrl+N" HotKey="Ctrl+N"/>
                <MenuItem Header="{Binding [Menu.NewFromDomain], Source={StaticResource S}}" Command="{Binding NewFromDomainCommand}"/>
                <MenuItem Header="{Binding [Menu.Convert], Source={StaticResource S}}" Command="{Binding ConvertScenarioCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding [Menu.NewSmarxRecipe], Source={StaticResource S}}" Command="{Binding NewSmarxFromRecipeCommand}"/>
                <MenuItem Header="{Binding [Menu.NewSmarx], Source={StaticResource S}}" Command="{Binding NewSmarxSampleCommand}"/>
                <MenuItem Header="{Binding [Menu.NewSmarxFromServers], Source={StaticResource S}}" Command="{Binding NewSmarxFromServersCommand}"/>
                <MenuItem Header="{Binding [Menu.OpenSmarx], Source={StaticResource S}}" Command="{Binding OpenSmarxCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding [Menu.OpenFolder], Source={StaticResource S}}" Command="{Binding OpenFolderCommand}" InputGesture="Ctrl+O" HotKey="Ctrl+O"/>
                <MenuItem Header="{Binding [Menu.Open], Source={StaticResource S}}" Command="{Binding OpenCommand}"/>
                <MenuItem Header="{Binding [Menu.Save], Source={StaticResource S}}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" HotKey="Ctrl+S"/>
                <MenuItem Header="{Binding [Menu.SaveAs], Source={StaticResource S}}" Command="{Binding SaveAsCommand}"/>
                <MenuItem Header="{Binding [Menu.ExportSheet], Source={StaticResource S}}" Command="{Binding ExportSheetCommand}"/>
                <MenuItem Header="{Binding [Menu.ExportSubject], Source={StaticResource S}}" Command="{Binding ExportSubjectCommand}"/>
                <MenuItem Header="{Binding [Menu.ShowFolder], Source={StaticResource S}}" Command="{Binding ShowProjectFolderCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding [Menu.Quit], Source={StaticResource S}}" Click="Quit"/>
            </MenuItem>
            <MenuItem Header="{Binding [Menu.View], Source={StaticResource S}}">
                <MenuItem Header="{Binding [Menu.ThemeLight], Source={StaticResource S}}" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                <MenuItem Header="{Binding [Menu.ThemeDark], Source={StaticResource S}}" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
            </MenuItem>
            <MenuItem Header="{Binding [Menu.Language], Source={StaticResource S}}">
                <MenuItem Header="Français" Command="{Binding SetLanguageCommand}" CommandParameter="fr-FR"/>
                <MenuItem Header="English" Command="{Binding SetLanguageCommand}" CommandParameter="en-US"/>
            </MenuItem>
        </Menu>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="footer">
            <TextBlock Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>

        <Grid>
            <!-- Aucun exercice ouvert -->
            <Border Classes="card" Padding="28,24" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding [Empty.Title], Source={StaticResource S}}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Classes="muted" Text="{Binding [Empty.Text], Source={StaticResource S}}" TextAlignment="Center" FontSize="13"/>
                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding NewFromRecipeCommand}" Content="{Binding [Menu.NewFromRecipe], Source={StaticResource S}}"/>
                    <Button Classes="tool" HorizontalAlignment="Stretch" Command="{Binding NewFromDomainCommand}" Content="{Binding [Menu.NewFromDomain], Source={StaticResource S}}"/>
                    <Button Classes="tool" HorizontalAlignment="Stretch" Command="{Binding ConvertScenarioCommand}" Content="{Binding [Menu.Convert], Source={StaticResource S}}"/>
                    <Button Classes="tool" HorizontalAlignment="Stretch" Command="{Binding OpenFolderCommand}" Content="{Binding [Menu.OpenFolder], Source={StaticResource S}}"/>
                    <Button Classes="tool" HorizontalAlignment="Stretch" Command="{Binding OpenCommand}" Content="{Binding [Menu.Open], Source={StaticResource S}}"/>
                    <Button Classes="tool" HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding NewSmarxFromRecipeCommand}" Content="{Binding [Menu.NewSmarxRecipe], Source={StaticResource S}}"/>
                    <Button Classes="tool" HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding NewSmarxSampleCommand}" Content="{Binding [Menu.NewSmarx], Source={StaticResource S}}"/>
                    <Button Classes="tool" HorizontalAlignment="Stretch" Command="{Binding OpenSmarxCommand}" Content="{Binding [Menu.OpenSmarx], Source={StaticResource S}}"/>
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,12,0,0" IsVisible="{Binding HasRecentLabs}">
                    <TextBlock Classes="label" Text="{Binding [Empty.Recent], Source={StaticResource S}}"/>
                    <ItemsControl ItemsSource="{Binding RecentLabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2" Background="Transparent" CornerRadius="8"
                                        Command="{Binding #Root.DataContext.OpenRecentCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            </Border>

            <!-- Un exercice SMAR-X -->
            <views:SmarxLabView DataContext="{Binding Smarx}" IsVisible="{Binding #Root.DataContext.HasSmarxLab}"/>

            <DockPanel IsVisible="{Binding HasLab}">
                <!-- Langue des textes édités -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,14,20,0" Spacing="10">
                    <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{Binding [Lab.EditCulture], Source={StaticResource S}}"/>
                    <ComboBox Width="140" ItemsSource="{Binding EditCultures}" SelectedItem="{Binding EditCultureChoice}"/>
                    <TextBlock Classes="mono" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" Foreground="{DynamicResource TextMuted}" Text="{Binding FilePath}"/>
                    <Button Classes="tool" VerticalAlignment="Center" Padding="8,2" IsVisible="{Binding HasProject}" Command="{Binding ShowProjectFolderCommand}" Content="{Binding [Menu.ShowFolder], Source={StaticResource S}}"/>
                </StackPanel>

                <TabControl Classes="suite" Margin="16,4,16,12">
                    <!-- ═══ Exercice ═══ -->
                    <TabItem Header="{Binding [Tab.Lab], Source={StaticResource S}}">
<Border Classes="card" Margin="0,10,0,0" Padding="16">
                        <ScrollViewer>
                            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Classes="label" Text="{Binding [Lab.Title], Source={StaticResource S}}"/>
                                <TextBox Text="{Binding LabTitle}"/>
                                <TextBlock Classes="label" Text="{Binding [Lab.Id], Source={StaticResource S}}"/>
                                <TextBox Text="{Binding LabId}"/>
                                <Grid ColumnDefinitions="*,16,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="label" Text="{Binding [Lab.Language], Source={StaticResource S}}"/>
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Languages}" SelectedItem="{Binding LanguageChoice}"/>
                                        <TextBlock Classes="label" Text="{Binding [Lab.Level], Source={StaticResource S}}"/>
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="label" Text="{Binding [Lab.Category], Source={StaticResource S}}"/>
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryChoice}"/>
                                        <TextBlock Classes="label" Text="{Binding [Lab.Duration], Source={StaticResource S}}"/>
                                        <NumericUpDown Minimum="1" Maximum="600" Increment="5" FormatString="0" Value="{Binding Duration}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="label" Text="{Binding [Lab.Domain], Source={StaticResource S}}"/>
                                <TextBlock Text="{Binding DomainSummary}" TextWrapping="Wrap"/>
                                <TextBlock Classes="label" Text="{Binding [Lab.Points], Source={StaticResource S}}"/>
                                <TextBlock Text="{Binding TotalPoints}"/>
                                <CheckBox Margin="0,16,0,2" IsChecked="{Binding IsExam}" Content="{Binding [Lab.Exam], Source={StaticResource S}}"/>
                                <TextBlock Classes="hint" Text="{Binding [Lab.Exam.Hint], Source={StaticResource S}}"/>
                                <!-- Réglages de l'examen : Vérifier permis, outils fermés (tous ouverts par défaut) -->
                                <StackPanel Margin="24,6,0,0" Spacing="2" IsVisible="{Binding IsExam}">
                                    <CheckBox IsChecked="{Binding ExamCheck}" Content="{Binding [Lab.ExamCheck], Source={StaticResource S}}"/>
                                    <TextBlock Classes="hint" Text="{Binding [Lab.ExamCheck.Hint], Source={StaticResource S}}"/>
                                    <TextBlock Classes="label" Text="{Binding [Lab.ExamTools], Source={StaticResource S}}"/>
                                    <CheckBox IsChecked="{Binding ExamCloseAudit}" Content="{Binding [Lab.ExamTools.Audit], Source={StaticResource S}}"/>
                                    <CheckBox IsChecked="{Binding ExamCloseFixGuidance}" Content="{Binding [Lab.ExamTools.FixGuidance], Source={StaticResource S}}"/>
                                    <CheckBox IsChecked="{Binding ExamCloseAttackPaths}" Content="{Binding [Lab.ExamTools.AttackPaths], Source={StaticResource S}}"/>
                                    <CheckBox IsChecked="{Binding ExamCloseComparison}" Content="{Binding [Lab.ExamTools.Comparison], Source={StaticResource S}}"/>
                                    <TextBlock Classes="hint" Text="{Binding [Lab.ExamTools.Hint], Source={StaticResource S}}"/>
                                </StackPanel>
                                <!-- Le sujet : ce qui se distribue, sans indices (examen) ni corrigé des questions -->
                                <Button Classes="tool" Margin="0,16,0,2" Command="{Binding ExportSubjectCommand}" Content="{Binding [Menu.ExportSubject], Source={StaticResource S}}"/>
                                <TextBlock Classes="hint" Text="{Binding [Lab.Subject.Hint], Source={StaticResource S}}"/>
                            </StackPanel>
                        </ScrollViewer>
</Border>
                    </TabItem>

                    <!-- ═══ Énoncé ═══ -->
                    <TabItem Header="{Binding [Tab.Statement], Source={StaticResource S}}">
<Border Classes="card" Margin="0,10,0,0" Padding="16">
                        <DockPanel >
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Classes="tool" Command="{Binding InsertTemplateCommand}" Content="{Binding [Statement.Template], Source={StaticResource S}}"/>
                                <TextBlock Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="900"
                                           Text="{Binding [Statement.Rule], Source={StaticResource S}}"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,12,*">
                                <TextBox Grid.Column="0" Classes="code" Text="{Binding Statement}" VerticalAlignment="Stretch"/>
                                <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="8,0,0,6" Text="{Binding [Statement.Preview], Source={StaticResource S}}"/>
                                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource CodeBg}">
                                        <ScrollViewer>
                                            <ContentControl Content="{Binding Statement, Converter={StaticResource MarkdownConverter}}"/>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
</Border>
                    </TabItem>

                    <!-- ═══ Objectifs ═══ -->
                    <TabItem Header="{Binding [Tab.Objectives], Source={StaticResource S}}">
<Border Classes="card" Margin="0,10,0,0" Padding="16">
                        <Grid ColumnDefinitions="380,12,*" >
                            <DockPanel Grid.Column="0">
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button Classes="tool" Command="{Binding AddObjectiveCommand}" Content="{Binding [Objectives.Add], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding RemoveObjectiveCommand}" Content="{Binding [Objectives.Remove], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding MoveUpCommand}" Content="▲"/>
                                    <Button Classes="tool" Command="{Binding MoveDownCommand}" Content="▼"/>
                                    <Button Classes="accent" Command="{Binding SuggestCommand}" Content="{Binding [Objectives.Suggest], Source={StaticResource S}}"/>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Run Text="{Binding [Lab.Points], Source={StaticResource S}}"/><Run Text=" : "/><Run Text="{Binding TotalPoints}"/>
                                </TextBlock>
                                <ListBox Classes="plain" Background="{DynamicResource CodeBg}" CornerRadius="8" ItemsSource="{Binding Objectives}" SelectedItem="{Binding SelectedObjective}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Classes="hint" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>

                            <Grid Grid.Column="2">
                                <!-- Éditeur de l'objectif sélectionné -->
                                <ScrollViewer IsVisible="{Binding !ShowSuggestions}">
                                    <StackPanel Margin="8,0,8,8" DataContext="{Binding SelectedObjective}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="label" Text="{Binding [Objective.Title], Source={StaticResource S}}"/>
                                        <TextBox Text="{Binding Title}"/>
                                        <TextBlock Classes="label" Text="{Binding [Objective.Hint], Source={StaticResource S}}"/>
                                        <TextBox Text="{Binding Hint}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                        <Grid ColumnDefinitions="120,16,*">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Classes="label" Text="{Binding [Objective.Points], Source={StaticResource S}}"/>
                                                <NumericUpDown Minimum="0" Maximum="50" FormatString="0" Value="{Binding Points}" IsEnabled="{Binding IsScored}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Classes="label" Text="{Binding [Objective.Check], Source={StaticResource S}}"/>
                                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.DataContext.CheckTypes}" SelectedItem="{Binding CheckType}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel IsVisible="{Binding ShowObject}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Object], Source={StaticResource S}}"/>
                                            <AutoCompleteBox Text="{Binding Object}" FilterMode="ContainsOrdinal" ItemsSource="{Binding #Root.DataContext.ObjectNames}"/>
                                            <TextBlock Classes="hint" IsVisible="{Binding ShowAnyUserHint}" Text="{Binding [Objective.AnyUser], Source={StaticResource S}}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowObjectType}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.ObjectType], Source={StaticResource S}}"/>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.DataContext.ObjectTypes}" SelectedItem="{Binding ObjectType}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowGroup}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Group], Source={StaticResource S}}"/>
                                            <AutoCompleteBox Text="{Binding Group}" FilterMode="ContainsOrdinal" ItemsSource="{Binding #Root.DataContext.ObjectNames}"/>
                                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding Effective}" Content="{Binding [Objective.Effective], Source={StaticResource S}}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowRule}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Rule], Source={StaticResource S}}"/>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.DataContext.RuleIds}" SelectedItem="{Binding RuleId}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowSeverity}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Severity], Source={StaticResource S}}"/>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.DataContext.Severities}" SelectedItem="{Binding Severity}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowScore}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Score], Source={StaticResource S}}"/>
                                            <NumericUpDown Minimum="0" Maximum="100" FormatString="0" Value="{Binding Score}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowFlag}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Flag], Source={StaticResource S}}"/>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.DataContext.Flags}" SelectedItem="{Binding Flag}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowTier}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Tier], Source={StaticResource S}}"/>
                                            <TextBox Text="{Binding Tier}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowTrustee}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Trustee], Source={StaticResource S}}"/>
                                            <AutoCompleteBox Text="{Binding Trustee}" FilterMode="ContainsOrdinal" ItemsSource="{Binding #Root.DataContext.ObjectNames}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowTarget}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Target], Source={StaticResource S}}"/>
                                            <AutoCompleteBox Text="{Binding Target}" FilterMode="ContainsOrdinal" ItemsSource="{Binding #Root.DataContext.ObjectNames}"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding ShowRight}">
                                            <TextBlock Classes="label" Text="{Binding [Objective.Right], Source={StaticResource S}}"/>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.DataContext.RightCategories}" SelectedItem="{Binding RightCategory}"/>
                                        </StackPanel>

                                        <Border Margin="0,14,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource ChipBg}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                <CheckBox IsVisible="{Binding CanBeGuard}" IsChecked="{Binding IsGuard}" Content="{Binding [Objective.IsGuard], Source={StaticResource S}}"/>
                                                <TextBlock Classes="hint" IsVisible="{Binding CanBeGuard}" Text="{Binding [Objective.Guard], Source={StaticResource S}}"/>
                                                <CheckBox IsVisible="{Binding CanBePartial}" IsChecked="{Binding IsPartial}" Content="{Binding [Objective.IsPartial], Source={StaticResource S}}"/>
                                                <TextBlock Classes="hint" IsVisible="{Binding CanBePartial}" Text="{Binding [Objective.Partial], Source={StaticResource S}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Propositions -->
                                <DockPanel IsVisible="{Binding ShowSuggestions}" Margin="8,0,0,0">
                                    <TextBlock DockPanel.Dock="Top" Classes="label" Margin="0,0,0,8" TextWrapping="Wrap"
                                               Text="{Binding [Objectives.Suggestions], Source={StaticResource S}}"/>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Classes="accent" Command="{Binding AddSelectedSuggestionsCommand}" Content="{Binding [Objectives.AddSelected], Source={StaticResource S}}"/>
                                        <Button Classes="tool" Command="{Binding CloseSuggestionsCommand}" Content="{Binding [Objectives.CloseSuggestions], Source={StaticResource S}}"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Classes="hint" IsVisible="{Binding !Suggestions.Count}"
                                               Text="{Binding [Objectives.NoSuggestion], Source={StaticResource S}}"/>
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Suggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6" Padding="8" CornerRadius="8" Background="{DynamicResource CodeBg}">
                                                        <CheckBox IsChecked="{Binding IsSelected}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Reason}" Classes="hint"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Grid>
</Border>
                    </TabItem>

                    <!-- ═══ Questions de compréhension ═══ -->
                    <TabItem Header="{Binding [Tab.Questions], Source={StaticResource S}}">
<Border Classes="card" Margin="0,10,0,0" Padding="16">
                        <Grid ColumnDefinitions="380,12,*" >
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8" Text="{Binding [Questions.Intro], Source={StaticResource S}}"/>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button Classes="accent" Command="{Binding AddQuestionCommand}" Content="{Binding [Questions.Add], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding RemoveQuestionCommand}" Content="{Binding [Objectives.Remove], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding MoveQuestionUpCommand}" Content="▲"/>
                                    <Button Classes="tool" Command="{Binding MoveQuestionDownCommand}" Content="▼"/>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Run Text="{Binding [Lab.Points], Source={StaticResource S}}"/><Run Text=" : "/><Run Text="{Binding TotalPoints}"/>
                                </TextBlock>
                                <ListBox Classes="plain" Background="{DynamicResource CodeBg}" CornerRadius="8" ItemsSource="{Binding Questions}" SelectedItem="{Binding SelectedQuestion}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>

                            <ScrollViewer Grid.Column="2">
                                <StackPanel Margin="8,0,8,8" DataContext="{Binding SelectedQuestion}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Classes="label" Text="{Binding [Question.Title], Source={StaticResource S}}"/>
                                    <TextBox Text="{Binding Title}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
                                    <Grid ColumnDefinitions="200,16,120">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Classes="label" Text="{Binding [Question.Kind], Source={StaticResource S}}"/>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding #Root.DataContext.QuestionKinds}" SelectedItem="{Binding KindChoice}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Classes="label" Text="{Binding [Question.Points], Source={StaticResource S}}"/>
                                            <NumericUpDown Minimum="0" Maximum="50" FormatString="0" Value="{Binding Points}"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Margin="0,8,0,0" IsVisible="{Binding CanBePartial}" IsChecked="{Binding Partial}" Content="{Binding [Question.Partial], Source={StaticResource S}}"/>

                                    <!-- Association : les paires -->
                                    <StackPanel IsVisible="{Binding IsMatching}">
                                        <TextBlock Classes="label" Text="{Binding [Question.Pairs], Source={StaticResource S}}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding Pairs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto,*,Auto" Margin="0,2">
                                                        <TextBox Grid.Column="0" Text="{Binding Left}"/>
                                                        <TextBlock Grid.Column="1" Text="→" Margin="8,0" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="2" Text="{Binding Right}"/>
                                                        <Button Classes="tool" Grid.Column="3" Margin="6,0,0,0" Content="✕"
                                                                Command="{Binding #Root.DataContext.SelectedQuestion.RemovePairCommand}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="tool" Margin="0,4,0,0" Command="{Binding AddPairCommand}" Content="{Binding [Question.AddPair], Source={StaticResource S}}"/>
                                    </StackPanel>

                                    <!-- Choix à cocher, ou intrus d'une association -->
                                    <StackPanel IsVisible="{Binding ShowChoices}">
                                        <TextBlock Classes="label" IsVisible="{Binding IsChoice}" Text="{Binding [Question.Choices], Source={StaticResource S}}"/>
                                        <TextBlock Classes="label" IsVisible="{Binding IsMatching}" Text="{Binding [Question.Distractors], Source={StaticResource S}}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding Choices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding Correct}" IsVisible="{Binding !#Root.DataContext.SelectedQuestion.IsMatching}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Text}"/>
                                                        <Button Classes="tool" Grid.Column="2" Margin="6,0,0,0" Content="✕" IsVisible="{Binding #Root.DataContext.SelectedQuestion.CanEditChoices}"
                                                                Command="{Binding #Root.DataContext.SelectedQuestion.RemoveChoiceCommand}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Classes="tool" Margin="0,4,0,0" Command="{Binding AddChoiceCommand}" IsVisible="{Binding IsChoice}"
                                                IsEnabled="{Binding CanEditChoices}" Content="{Binding [Question.AddChoice], Source={StaticResource S}}"/>
                                        <Button Classes="tool" Margin="0,4,0,0" Command="{Binding AddChoiceCommand}" IsVisible="{Binding IsMatching}"
                                                Content="{Binding [Question.AddDistractor], Source={StaticResource S}}"/>
                                    </StackPanel>

                                    <!-- Réponse écrite -->
                                    <StackPanel IsVisible="{Binding IsText}">
                                        <TextBlock Classes="label" Text="{Binding [Question.Accepted], Source={StaticResource S}}"/>
                                        <TextBox Text="{Binding AcceptedAnswers}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                        <TextBlock Classes="hint" Text="{Binding [Question.Accepted.Hint], Source={StaticResource S}}"/>
                                    </StackPanel>

                                    <TextBlock Classes="label" Text="{Binding [Question.Hint], Source={StaticResource S}}"/>
                                    <TextBox Text="{Binding Hint}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
</Border>
                    </TabItem>

                    <!-- ═══ Validation ═══ -->
                    <TabItem Header="{Binding [Tab.Validation], Source={StaticResource S}}">
<Border Classes="card" Margin="0,10,0,0" Padding="16">
                        <DockPanel >
                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                <TextBlock Classes="hint" Text="{Binding [Validation.Intro], Source={StaticResource S}}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="accent" Command="{Binding ValidateCommand}" Content="{Binding [Validation.Run], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding ProposeSolutionCommand}" Content="{Binding [Validation.Propose], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding ChooseSolutionCommand}" Content="{Binding [Validation.Solution], Source={StaticResource S}}"/>
                                </StackPanel>
                                <TextBlock Classes="hint" Text="{Binding SolutionLabel}"/>
                            </StackPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="24,*" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" Foreground="{Binding Color}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
</Border>
                    </TabItem>

                    <!-- ═══ Fiche formateur ═══ -->
                    <TabItem Header="{Binding [Tab.Sheet], Source={StaticResource S}}">
<Border Classes="card" Margin="0,10,0,0" Padding="16">
                        <Grid ColumnDefinitions="*,12,*" >
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,6" Text="{Binding [Sheet.Notes], Source={StaticResource S}}"/>
                                <TextBox Classes="code" Text="{Binding Notes}" VerticalAlignment="Stretch"/>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
                            <DockPanel Grid.Column="2">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,6">
                                    <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding [Sheet.Preview], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Margin="12,0,0,0" Command="{Binding ExportSheetCommand}" Content="{Binding [Menu.ExportSheet], Source={StaticResource S}}"/>
                                </StackPanel>
                                <Border Padding="12" CornerRadius="8" Background="{DynamicResource CodeBg}">
                                    <ScrollViewer>
                                        <ContentControl Content="{Binding SheetPreview, Converter={StaticResource MarkdownConverter}}"/>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Grid>
</Border>
                    </TabItem>
                    <!-- ═══ Copies : corriger une classe ═══ -->
                    <TabItem Header="{Binding [Tab.Submissions], Source={StaticResource S}}">
<Border Classes="card" Margin="0,10,0,0" Padding="16">
                        <DockPanel >
                            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
                                <TextBlock Classes="hint" Text="{Binding [Submissions.Intro], Source={StaticResource S}}"/>
                                <WrapPanel>
                                    <Button Classes="accent" Command="{Binding AddSubmissionsCommand}" Content="{Binding [Submissions.Add], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding AddSubmissionFolderCommand}" Content="{Binding [Submissions.AddFolder], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding RegradeSubmissionsCommand}" Content="{Binding [Submissions.Regrade], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding ExportGradesCommand}" Content="{Binding [Submissions.ExportCsv], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding ExportMoodleCommand}" Content="{Binding [Submissions.ExportMoodle], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding ExportReportsCommand}" Content="{Binding [Submissions.ExportReports], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding ExportClassReportCommand}" Content="{Binding [Submissions.ExportReport], Source={StaticResource S}}"/>
                                    <Button Classes="tool" Command="{Binding ClearSubmissionsCommand}" Content="{Binding [Submissions.Clear], Source={StaticResource S}}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="label" VerticalAlignment="Center" Margin="0" Text="{Binding [Submissions.Scale], Source={StaticResource S}}"/>
                                        <NumericUpDown Minimum="1" Maximum="1000" FormatString="0" Value="{Binding Scale}" Width="110"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ClassSummary}"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,12,400">
                                <DockPanel Grid.Column="0">
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="190,80,55,55,150,130,*" Margin="12,0,12,4">
                                        <TextBlock Grid.Column="0" Classes="hint" FontWeight="SemiBold" Text="{Binding [Submissions.Student], Source={StaticResource S}}"/>
                                        <TextBlock Grid.Column="1" Classes="hint" FontWeight="SemiBold" Text="{Binding [Submissions.Grade], Source={StaticResource S}}"/>
                                        <TextBlock Grid.Column="2" Classes="hint" FontWeight="SemiBold" Text="%"/>
                                        <TextBlock Grid.Column="3" Classes="hint" FontWeight="SemiBold" Text="{Binding [Submissions.Hints], Source={StaticResource S}}"/>
                                        <TextBlock Grid.Column="4" Classes="hint" FontWeight="SemiBold" Text="{Binding [Submissions.Objectives], Source={StaticResource S}}"/>
                                        <TextBlock Grid.Column="5" Classes="hint" FontWeight="SemiBold" Text="{Binding [Submissions.SavedAt], Source={StaticResource S}}"/>
                                        <TextBlock Grid.Column="6" Classes="hint" FontWeight="SemiBold" Text="{Binding [Submissions.Remarks], Source={StaticResource S}}"/>
                                    </Grid>
                                    <ListBox Classes="plain" Background="{DynamicResource CodeBg}" CornerRadius="8" ItemsSource="{Binding Submissions}" SelectedItem="{Binding SelectedSubmission}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="190,80,55,55,150,130,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding Student}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Grade}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Percent}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Hints}"/>
                                                    <ItemsControl Grid.Column="4" ItemsSource="{Binding Marks}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="11" Height="11" Margin="0,1,3,1" CornerRadius="2"
                                                                        Background="{Binding Color}" ToolTip.Tip="{Binding Tip}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="5" Text="{Binding SavedAt}" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Remarks}" Foreground="{Binding RemarksColor}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
                                <TabControl Grid.Column="2" Classes="suite">
                                  <!-- Copie sélectionnée : les réponses, les points donnés à la main, l'appréciation -->
                                  <TabItem Header="{Binding [Submissions.Selected], Source={StaticResource S}}">
                                    <ScrollViewer>
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedSubmission}" Text="{Binding [Submissions.NoSelection], Source={StaticResource S}}"/>
                                            <StackPanel Spacing="6" IsVisible="{Binding HasSelectedSubmission}">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding SelectedSubmission.Student}"/>
                                                <TextBlock Text="{Binding SelectedSubmission.Grade}"/>
                                                <ItemsControl ItemsSource="{Binding SelectedAnswers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8" Padding="8" CornerRadius="8" Background="{DynamicResource CodeBg}">
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock TextWrapping="Wrap">
                                                                        <Run Text="{Binding [Submissions.Answer], Source={StaticResource S}}"/><Run Text=" : "/><Run Text="{Binding Answer}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Classes="hint">
                                                                        <Run Text="{Binding [Submissions.Automatic], Source={StaticResource S}}"/><Run Text=" : "/><Run Text="{Binding Automatic}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Classes="hint" Text="{Binding [Submissions.Manual], Source={StaticResource S}}" TextWrapping="Wrap"/>
                                                                    <NumericUpDown Minimum="0" Maximum="{Binding Max}" Increment="0.5" FormatString="0.##" Value="{Binding Points}" Width="120" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="label" Text="{Binding [Submissions.Comment], Source={StaticResource S}}"/>
                                                <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                                                <Button Classes="accent" Command="{Binding SaveMarksCommand}" Content="{Binding [Submissions.SaveMarks], Source={StaticResource S}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                  </TabItem>
                                  <TabItem Header="{Binding [Submissions.Rates], Source={StaticResource S}}">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding ObjectiveRates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,10" Spacing="3">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="8" MinWidth="0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Rate}" Classes="hint"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                  </TabItem>
                                </TabControl>
                            </Grid>
                        </DockPanel>
</Border>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
