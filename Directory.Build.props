<Project>
  <!-- Seule source du numéro de version, commune à SMAD-X, SMAD-X Studio et au noyau :
       « À propos », propriétés des exe ; le tag vX.Y.Z de la release doit correspondre (vérifié par release.yml). -->
  <PropertyGroup>
    <Version>0.9.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
