<Project Sdk="Microsoft.NET.Sdk">
  <!-- Moteur de SMAR-X (Simulate, Model and Audit Rights eXpert), sans interface : modèle des serveurs
       (comptes, groupes, arborescence, droits) et calcul des droits effectifs, expliqués étape par étape. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>SMAR-X.Core</AssemblyName>
    <RootNamespace>SMARX</RootNamespace>
  </PropertyGroup>
</Project>
