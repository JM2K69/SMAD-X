<Project Sdk="Microsoft.NET.Sdk">
  <!-- Captures d'écran de SMAD-X Studio pour le site de documentation, rendues hors écran (Avalonia Headless + Skia).
       Un processus ne peut lancer qu'une application Avalonia : Studio a donc son propre générateur, à côté de DocGenerator.
       Commande : voir docs/README.md -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SMAD-X.Studio\SMAD-X.Studio.csproj" />
  </ItemGroup>
</Project>
