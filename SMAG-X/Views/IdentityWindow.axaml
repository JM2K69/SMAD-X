<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SMAGX.Views.IdentityWindow"
        Title="{DynamicResource Identity.Title}"
        Icon="/Assets/icone.ico"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Border Padding="24">
        <StackPanel Spacing="12">
            <TextBlock x:Name="Heading" Classes="h" Text="{DynamicResource Identity.Title}"/>
            <TextBlock x:Name="Intro" Classes="muted" Text="{DynamicResource Identity.Intro}" TextWrapping="Wrap"/>
            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource Identity.Name}"/>
                <TextBox x:Name="NameBox" PlaceholderText="Alice Martin" TextChanged="OnNameChanged"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource Identity.Email}"/>
                <TextBox x:Name="EmailBox" PlaceholderText="alice@lycee.example"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource Identity.Login}"/>
                <TextBox x:Name="LoginBox" Classes="mono" PlaceholderText="alice" TextChanged="OnLoginChanged"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Classes="tool" Content="{DynamicResource Identity.Cancel}" Click="OnCancel"/>
                <Button x:Name="OkButton" Classes="accent" Content="{DynamicResource Identity.Ok}" Click="OnOk" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
