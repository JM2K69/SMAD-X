<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMAGX.ViewModels"
        x:Class="SMAGX.Views.KeysWindow"
        x:DataType="vm:KeysViewModel"
        Title="{Binding Heading}"
        Icon="/Assets/icone.ico"
        Width="720" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Border Padding="24">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource KeyIcon}" Width="20" Height="20" Foreground="{DynamicResource Accent}"/>
                <TextBlock Classes="h" Text="{Binding Heading}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Classes="muted" Text="{DynamicResource Keys.Intro}" TextWrapping="Wrap"/>

            <!-- Les clés du compte -->
            <TextBlock Classes="muted" Text="{DynamicResource Keys.None}" TextWrapping="Wrap" IsVisible="{Binding NoKey}"/>
            <ItemsControl ItemsSource="{Binding Keys}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyItem">
                        <Border Classes="code" Padding="12,8" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="danger" Content="{DynamicResource Keys.Remove}" VerticalAlignment="Center"
                                        Command="{ReflectionBinding $parent[Window].DataContext.RemoveCommand}" CommandParameter="{Binding}"/>
                                <PathIcon DockPanel.Dock="Left" Data="{StaticResource KeyIcon}" Width="16" Height="16" Margin="0,0,10,0"
                                          Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <SelectableTextBlock Classes="mono" Text="{Binding Fingerprint}" FontSize="12"/>
                                    <TextBlock Classes="muted" Text="{Binding Details}" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ajouter une clé -->
            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource Keys.Key}"/>
                <TextBox Classes="mono" Text="{Binding KeyText}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         PlaceholderText="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA… alice@lycee.example"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource Keys.TitleLabel}"/>
                <TextBox Text="{Binding Title}" PlaceholderText="{DynamicResource Keys.TitleHint}"/>
            </StackPanel>
            <TextBlock Foreground="{DynamicResource Danger}" Text="{Binding Error}" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Classes="tool" Content="{DynamicResource Collab.Close}" Click="OnClose" IsCancel="True"/>
                <Button Classes="accent" Content="{DynamicResource Keys.Add}" Command="{Binding AddCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
