<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SMAGX.Views.EditorWindow"
        Title="{DynamicResource Editor.Title}"
        Icon="/Assets/icone.ico"
        Width="720" Height="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <TextBlock Classes="muted" Text="{DynamicResource Editor.Intro}" TextWrapping="Wrap"/>
        <TextBox x:Name="TextBox" Grid.Row="1" Classes="mono" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="tool" Content="{DynamicResource Editor.Cancel}" Click="OnCancel"/>
            <Button Classes="accent" Content="{DynamicResource Editor.Save}" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
