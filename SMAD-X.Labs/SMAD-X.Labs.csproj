<Project Sdk="Microsoft.NET.Sdk">
  <!-- Socle commun des simulateurs SMAD-X, sans interface ni Active Directory : traductions FR/EN et
       fiches Markdown, questions de compréhension et leur correction, sceau et session des copies,
       notes du formateur, journal, texte sûr. Partagé par SMAD-X.Core et les autres simulateurs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>SMAD-X.Labs</AssemblyName>
    <RootNamespace>SMADX</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Polices de secours du PDF (emoji, symboles, flèches), embarquées pour un rendu identique sur tous les OS ;
         partagées par les PDF de SMAD-X, de Studio et de SMAR-X (Services/MarkdownPdf.cs) -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OfficeIMO.Markdown.Pdf" Version="3.5.1" />
  </ItemGroup>
</Project>
