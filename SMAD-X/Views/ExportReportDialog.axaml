<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:helpers="using:SMADX.Helpers"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
		x:Class="SMADX.Views.ExportReportDialog"
		Width="480" Height="360"
		CanResize="False"
		WindowStartupLocation="CenterOwner"
		Title="Export">

	<Window.Resources>
		<helpers:LocalizationProxy x:Key="Loc"/>
	</Window.Resources>

	<Grid RowDefinitions="*,Auto" Margin="20">

		<StackPanel Grid.Row="0" Spacing="16">

			<!-- Title -->
			<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportDialogTitle}"
					   FontSize="16" FontWeight="SemiBold"/>

			<!-- Scope -->
			<StackPanel Spacing="6">
				<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportScopeLabel}"
						   FontWeight="SemiBold"/>
				<RadioButton x:Name="RadioCombined"
							 Content="{Binding Source={StaticResource Loc}, Path=ReportScopeCombined}"
							 IsChecked="True"
							 GroupName="Scope"
							 IsCheckedChanged="OnScopeChanged"/>
				<RadioButton x:Name="RadioIndividual"
							 Content="{Binding Source={StaticResource Loc}, Path=ReportScopeIndividual}"
							 GroupName="Scope"
							 IsCheckedChanged="OnScopeChanged"/>
			</StackPanel>

			<!-- Individual element picker -->
			<StackPanel x:Name="IndividualPanel" Spacing="6" IsVisible="False">
				<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportScopeObjectLabel}"
						   FontWeight="SemiBold"/>
				<ComboBox x:Name="ElementComboBox"
						  HorizontalAlignment="Stretch"
						  DisplayMemberBinding="{Binding DisplayName}"/>
			</StackPanel>

			<!-- Format -->
			<StackPanel Spacing="6">
				<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportFormatLabel}"
						   FontWeight="SemiBold"/>
				<StackPanel Orientation="Horizontal" Spacing="16">
					<RadioButton x:Name="RadioMd"
								 Content="{Binding Source={StaticResource Loc}, Path=ReportFormatMarkdown}"
								 IsChecked="True"
								 GroupName="Format"/>
					<RadioButton x:Name="RadioDocx"
								 Content="{Binding Source={StaticResource Loc}, Path=ReportFormatDocx}"
								 GroupName="Format"/>
					<RadioButton x:Name="RadioPdf"
								 Content="{Binding Source={StaticResource Loc}, Path=ReportFormatPdf}"
								 GroupName="Format"/>
				</StackPanel>
			</StackPanel>

		</StackPanel>

		<!-- Buttons -->
		<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
			<Button Grid.Column="1"
					Content="{Binding Source={StaticResource Loc}, Path=ReportButtonExport}"
					Click="OnExportClick"
					Padding="20,8" Margin="0,0,8,0"
					Background="#1E5631" Foreground="White"/>
			<Button Grid.Column="2"
					Content="{Binding Source={StaticResource Loc}, Path=ReportButtonCancel}"
					Click="OnCancelClick"
					Padding="20,8"/>
		</Grid>

	</Grid>
</Window>
