<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:helpers="using:SMADX.Helpers"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="530" d:DesignHeight="580"
		x:Class="SMADX.Views.ExportReportDialog"
		Width="545" MaxHeight="700" SizeToContent="Height"
		CanResize="True"
		WindowStartupLocation="CenterOwner"
		Title="Export">

	<Window.Resources>
		<helpers:LocalizationProxy x:Key="Loc"/>
	</Window.Resources>

	<Grid RowDefinitions="Auto,Auto" Margin="20">

		<StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,0">

				<!-- Title -->
				<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportDialogTitle}"
						   FontSize="16" FontWeight="SemiBold"/>

				<!-- Scope -->
				<StackPanel Spacing="6">
					<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportScopeLabel}"
							   FontWeight="SemiBold"/>
					<RadioButton x:Name="RadioCombined"
								 Content="{Binding Source={StaticResource Loc}, Path=ReportScopeCombined}"
								 IsChecked="True"
								 GroupName="Scope"
								 IsCheckedChanged="OnScopeChanged"/>
					<RadioButton x:Name="RadioIndividual"
								 Content="{Binding Source={StaticResource Loc}, Path=ReportScopeIndividual}"
								 GroupName="Scope"
								 IsCheckedChanged="OnScopeChanged"/>
				</StackPanel>

				<!-- Individual element picker -->
				<StackPanel x:Name="IndividualPanel" Spacing="8" IsVisible="False">

					<!-- Type filter – multi-select checkboxes, one per type -->
					<StackPanel Spacing="4">
						<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportScopeTypeFilter}"
								   FontWeight="SemiBold"/>
						<Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,4">
							<ItemsControl x:Name="TypeFilterList">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
													  Content="{Binding Label}"
													  Margin="4,2"
													  Click="OnTypeFilterCheckChanged"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>
					</StackPanel>

					<!-- Header: label + Select All / None -->
					<DockPanel>
						<TextBlock DockPanel.Dock="Left"
								   Text="{Binding Source={StaticResource Loc}, Path=ReportScopeObjectLabel}"
								   FontWeight="SemiBold" VerticalAlignment="Center"/>
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
									HorizontalAlignment="Right">
							<Button x:Name="BtnSelectAll"
									Content="{Binding Source={StaticResource Loc}, Path=ReportScopeSelectAll}"
									Click="OnSelectAll" Padding="8,3" FontSize="11"/>
							<Button x:Name="BtnSelectNone"
									Content="{Binding Source={StaticResource Loc}, Path=ReportScopeSelectNone}"
									Click="OnSelectNone" Padding="8,3" FontSize="11"/>
						</StackPanel>
					</DockPanel>

					<!-- Scrollable checkbox list -->
					<Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
						<ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
							<ItemsControl x:Name="ElementList" Margin="6">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
												  Content="{Binding DisplayName}"
												  Margin="2,2"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Border>

					<!-- Selected count -->
					<TextBlock x:Name="SelectedCountLabel" FontSize="11" Foreground="Gray"/>

				</StackPanel>

				<!-- Format – always visible, MD always checked -->
					<StackPanel Spacing="6">
						<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportFormatLabel}"
								   FontWeight="SemiBold"/>
						<StackPanel Orientation="Horizontal" Spacing="16">
							<CheckBox x:Name="ChkMd"
									  Content="{Binding Source={StaticResource Loc}, Path=ReportFormatMarkdown}"
									  IsChecked="True"
									  IsEnabled="False"
									  ToolTip.Tip="Markdown is always exported"/>
							<CheckBox x:Name="ChkDocx"
									  Content="{Binding Source={StaticResource Loc}, Path=ReportFormatDocx}"
									  IsCheckedChanged="OnFormatCheckChanged"/>
							<CheckBox x:Name="ChkPdf"
									  Content="{Binding Source={StaticResource Loc}, Path=ReportFormatPdf}"
									  IsCheckedChanged="OnFormatCheckChanged"/>
						</StackPanel>

						<!-- Theme picker — visible only when DOCX or PDF is selected -->
						<StackPanel x:Name="ThemePanel" Orientation="Horizontal" Spacing="8"
									IsVisible="False" Margin="0,4,0,0">
							<TextBlock Text="{Binding Source={StaticResource Loc}, Path=ReportThemeLabel}"
									   VerticalAlignment="Center" FontWeight="SemiBold"/>
							<ComboBox x:Name="ThemeCombo" MinWidth="180" SelectedIndex="0">
								<ComboBoxItem Tag="WordLike">WordLike</ComboBoxItem>
								<ComboBoxItem Tag="Plain">Plain</ComboBoxItem>
								<ComboBoxItem Tag="TechnicalDocument">Technical Document</ComboBoxItem>
								<ComboBoxItem Tag="GitHubLike">GitHub</ComboBoxItem>
								<ComboBoxItem Tag="Compact">Compact</ComboBoxItem>
								<ComboBoxItem Tag="Report">Report</ComboBoxItem>
							</ComboBox>
						</StackPanel>
					</StackPanel>

			</StackPanel>

			<!-- Buttons -->
		<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
			<Button Grid.Column="1"
					Content="{Binding Source={StaticResource Loc}, Path=ReportButtonExport}"
					Click="OnExportClick"
					Padding="20,8" Margin="0,0,8,0"
					Background="#1E5631" Foreground="White"/>
			<Button Grid.Column="2"
					Content="{Binding Source={StaticResource Loc}, Path=ReportButtonCancel}"
					Click="OnCancelClick"
					Padding="20,8"/>
		</Grid>

	</Grid>
</Window>
