<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SMADX.Views.ErrorWindow"
        Title="{Binding Source={StaticResource Loc}, Path=ErrorTitle}"
        Icon="/Assets/icone.ico"
        Width="720" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <StackPanel Margin="18" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="⚠️" FontSize="28" VerticalAlignment="Top"/>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=ErrorIntro}" TextWrapping="Wrap" MaxWidth="620"/>
                <TextBlock x:Name="MessageText" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="620"/>
                <TextBlock x:Name="MoreErrorsText" Opacity="0.8" IsVisible="False" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Expander Header="{Binding Source={StaticResource Loc}, Path=ErrorDetails}" HorizontalAlignment="Stretch">
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="320"
                     FontFamily="Consolas, Courier New, monospace" FontSize="11"/>
        </Expander>

        <TextBlock x:Name="LogFileText" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource Loc}, Path=ErrorCopy}" Click="OnCopyClick" Padding="12,5"/>
            <Button Content="{Binding Source={StaticResource Loc}, Path=ErrorOpenLog}" Click="OnOpenLogClick" Padding="12,5"/>
            <Button Content="{Binding Source={StaticResource Loc}, Path=ErrorClose}" Click="OnCloseClick" Padding="12,5" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
