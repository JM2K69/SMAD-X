<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        x:Class="SMADX.Views.ObjectPickerWindow"
        x:DataType="vm:ObjectPickerViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icone.ico"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=DialogPickerTypes}" VerticalAlignment="Center"/>
            <ItemsControl ItemsSource="{Binding Kinds}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PickerKind">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBox Grid.Row="1" Text="{Binding Filter}" PlaceholderText="{Binding Source={StaticResource Loc}, Path=DialogPickerFilter}"/>

        <ListBox Grid.Row="2" ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PickerEntry">
                    <CheckBox IsChecked="{Binding IsSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogPickerAdd}" Click="OnAddClick" Padding="14,5"/>
            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosCancel}" Click="OnCancelClick" Padding="14,5"/>
        </StackPanel>
    </Grid>
</Window>
