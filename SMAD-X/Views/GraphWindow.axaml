<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        xmlns:graph="using:SMADX.Graph"
        x:Class="SMADX.Views.GraphWindow"
        x:Name="GraphWindowRoot"
        Title="{Binding Source={StaticResource Loc}, Path=GraphTitle}"
        Icon="/Assets/icone.ico"
        Width="1250" Height="780"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        RequestedThemeVariant="Dark">

    <!-- Les pictogrammes des boutons, des filtres et de la barre d'info sont au trait, comme sur les nœuds (GraphSymbols) -->
    <Window.Resources>
        <graph:GraphLabelConverter x:Key="GraphLabel"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="0" Classes="header" Padding="14,10">
            <StackPanel Orientation="Vertical" Spacing="8">

                <!-- Ligne 1 : boutons de contrôle + stats -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StatsText}"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                               FontSize="11" Margin="0,0,4,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BtnFitView"
                                Content="{Binding Source={StaticResource Loc}, Path=GraphFitView, Converter={StaticResource GraphLabel}}"
                                ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=GraphFitViewTooltip}"
                                Click="OnFitView" Classes="accent"/>
                        <Button x:Name="BtnZoomIn"
                                Content="{Binding Source={StaticResource Loc}, Path=GraphZoomIn, Converter={StaticResource GraphLabel}}"
                                Click="OnZoomIn" Classes="tool"/>
                        <Button x:Name="BtnZoomOut"
                                Content="{Binding Source={StaticResource Loc}, Path=GraphZoomOut, Converter={StaticResource GraphLabel}}"
                                Click="OnZoomOut" Classes="tool"/>
                        <Button x:Name="BtnRelayout"
                                Content="{Binding Source={StaticResource Loc}, Path=GraphRelayout, Converter={StaticResource GraphLabel}}"
                                ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=GraphRelayoutTooltip}"
                                Click="OnRelayout" Classes="tool"/>
                        <Button x:Name="BtnRefresh"
                                Content="{Binding Source={StaticResource Loc}, Path=GraphReload, Converter={StaticResource GraphLabel}}"
                                ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=GraphReloadTooltip}"
                                Click="OnRefresh" Classes="tool"/>
                    </StackPanel>
                </DockPanel>

                <!-- Ligne 2 : filtres (wrap automatique) -->
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=GraphFilters}"
                               Classes="label" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterMemberOf, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowMemberOf, Mode=TwoWay}"
                              Foreground="#BB86FC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterGroupNesting, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowGroupNesting, Mode=TwoWay}"
                              Foreground="#E040FB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterGpoLinks, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowGpoLinks, Mode=TwoWay}"
                              Foreground="#FFB347" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterGpoInheritance, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowGpoInheritance, Mode=TwoWay}"
                              Foreground="#D08000" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterPso, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowPsoLinks, Mode=TwoWay}"
                              Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterDelegations, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowDelegations, Mode=TwoWay}"
                              Foreground="#FFB300" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterHierarchy, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowHierarchy, Mode=TwoWay}"
                              Foreground="#888888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=GraphFilterIsolated, Converter={StaticResource GraphLabel}}"
                              IsChecked="{Binding #GraphWindowRoot.DataContext.ShowIsolated, Mode=TwoWay}"
                              Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </WrapPanel>

            </StackPanel>
        </Border>

        <!-- ═══ CANVAS GRAPHE ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource CodeBg}" ClipToBounds="True">
            <ContentControl x:Name="GraphHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>

        <!-- ═══ BARRE D'INFO NŒUD SÉLECTIONNÉ ═══ -->
        <Border Grid.Row="2" Classes="footer" Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <ContentControl Grid.Column="0"
                                Content="{Binding SelectedNodeInfo, Converter={StaticResource GraphLabel}, ConverterParameter=mono}"
                                Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" FontSize="12"/>
                <Button Grid.Column="1"
                        Content="{Binding Source={StaticResource Loc}, Path=GraphClose, Converter={StaticResource GraphLabel}}"
                        Click="OnClose"
                        Classes="accent" MinWidth="90" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
