<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        xmlns:audit="using:SMADX.Services.Audit"
        x:Class="SMADX.Views.AuditWindow"
        x:Name="AuditWindowRoot"
        x:DataType="vm:AuditViewModel"
        Title="{Binding Source={StaticResource Loc}, Path=AuditWindowTitle}"
        Icon="/Assets/icone.ico"
        Width="1250" Height="800"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- ═══ Synthèse : score, niveau ANSSI estimé, compteurs, filtre ═══ -->
        <Border Grid.Row="0" Classes="card" Padding="18,14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Classes="label" Text="{Binding Source={StaticResource Loc}, Path=AuditScore}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Score}" FontSize="36" FontWeight="Bold" Foreground="{Binding ScoreColor}"/>
                        <TextBlock Classes="muted" Text=" / 100" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,32,0"
                            ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=AuditAnssiLevelNote}">
                    <TextBlock Classes="label" Text="{Binding Source={StaticResource Loc}, Path=AuditAnssiLevel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding EstimatedAnssiLevel}" FontSize="36" FontWeight="Bold"/>
                        <TextBlock Classes="muted" Text=" / 5  ⓘ" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#C0392B" CornerRadius="999" Padding="10,3">
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <Run Text="{Binding CriticalCount}"/><Run Text=" "/><Run Text="{Binding Source={StaticResource Loc}, Path=AuditSeverityCritical}"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#E67E22" CornerRadius="999" Padding="10,3">
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <Run Text="{Binding HighCount}"/><Run Text=" "/><Run Text="{Binding Source={StaticResource Loc}, Path=AuditSeverityHigh}"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#D4AC0D" CornerRadius="999" Padding="10,3">
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <Run Text="{Binding MediumCount}"/><Run Text=" "/><Run Text="{Binding Source={StaticResource Loc}, Path=AuditSeverityMedium}"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#2E86C1" CornerRadius="999" Padding="10,3">
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <Run Text="{Binding LowCount}"/><Run Text=" "/><Run Text="{Binding Source={StaticResource Loc}, Path=AuditSeverityLow}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding Summary}" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" Width="190"/>
                    <Button Classes="accent" Content="{Binding Source={StaticResource Loc}, Path=AuditRun}" Command="{Binding RunCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Constats | fiche de la règle ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="5*,12,6*">

            <Border Grid.Column="0" Classes="card" Padding="6">
                <ListBox Classes="plain" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AuditFindingItem">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Border Grid.Column="0" Background="{Binding SeverityColor}" CornerRadius="6" Padding="6,2"
                                        VerticalAlignment="Top" Margin="0,2,10,0" MinWidth="70">
                                    <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                        <Run Text="{Binding RuleId}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding RuleTitle}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ObjectName}" FontSize="12"/>
                                    <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>

            <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelection}">
                <ScrollViewer>
                    <StackPanel Spacing="10" DataContext="{Binding SelectedFinding}" x:DataType="vm:AuditFindingItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{Binding SeverityColor}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Classes="mono" Text="{Binding RuleId}" VerticalAlignment="Center"/>
                            <TextBlock Classes="muted" Text="{Binding AnssiLevelLabel}" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding ObjectName}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Classes="muted mono" Text="{Binding ObjectDistinguishedName}" FontSize="11"/>
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Classes="tool" Content="{Binding Source={StaticResource Loc}, Path=AuditSelectInTree}"
                                Command="{Binding #AuditWindowRoot.DataContext.ShowInTreeCommand}"/>

                        <Separator/>

                        <ContentControl Content="{Binding Documentation, Converter={StaticResource MarkdownConverter}}"/>

                        <Separator/>

                        <TextBlock Classes="label" Text="{Binding Source={StaticResource Loc}, Path=AuditReferences}"/>
                        <ItemsControl ItemsSource="{Binding References}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="audit:AuditReference">
                                    <HyperlinkButton NavigateUri="{Binding Url}" Padding="0,2" ToolTip.Tip="{Binding Url}">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}">
                                            <Run Text="{Binding FrameworkLabel}" FontWeight="SemiBold"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Id}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Title}"/>
                                        </TextBlock>
                                    </HyperlinkButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
