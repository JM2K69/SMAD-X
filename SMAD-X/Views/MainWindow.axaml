<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        xmlns:services="using:SMADX.Services"
        xmlns:helpers="using:SMADX.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="SMADX.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWindowRoot"
        Icon="/Assets/icone.ico"
        Title="{Binding WindowTitle}"
        Width="1400" Height="855">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Bindings MVVM pour TreeViewItem — les couleurs sont dans AppStyles.axaml -->
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- En-tête : l'application et ses menus, puis la barre d'outils -->
        <StackPanel Grid.Row="0">
          <Border Classes="header" Padding="20,10">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" DataContext="{StaticResource Loc}">
                    <Border Width="38" Height="38" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#4C9AFF" Offset="0"/>
                                <GradientStop Color="#2BB3A3" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Data="{StaticResource DirectoryIcon}" Width="20" Height="20" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMAD-X" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Classes="muted" Text="{Binding AboutFullName}"/>
                    </StackPanel>
                </StackPanel>
            <!-- Menu principal -->
            <Menu Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center" x:Name="MainMenu" DataContext="{StaticResource Loc}">
                <MenuItem Header="{Binding MenuFile}">
                    <!-- En mode exercice, rien ne remplace le domaine de l'apprenant, et Ctrl+S enregistre sa copie -->
                    <MenuItem Header="{Binding MenuFileNewDomain}" Command="{Binding #MainWindowRoot.DataContext.CreateNewDomainCommand}" InputGesture="Ctrl+N" IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}"/>
                    <MenuItem Header="{Binding MenuFileNewStructure}" Command="{Binding #MainWindowRoot.DataContext.InitializeSampleDataCommand}" InputGesture="Ctrl+Shift+N" IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}"/>
                    <Separator IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}"/>
                    <MenuItem Header="{Binding MenuFileOpen}" Command="{Binding #MainWindowRoot.DataContext.LoadFromFileCommand}" InputGesture="Ctrl+O" IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}"/>
                    <MenuItem Header="{Binding MenuFileSave}" Command="{Binding #MainWindowRoot.DataContext.SaveToFileCommand}" InputGesture="Ctrl+S" IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}"/>
                    <MenuItem Header="{Binding MenuLabsSaveSubmission}" Command="{Binding #MainWindowRoot.DataContext.SaveSubmissionCommand}" InputGesture="Ctrl+S"
                              IsVisible="{Binding #MainWindowRoot.DataContext.IsLabMode}"/>
                    <Separator/>
                    <MenuItem Header="{Binding MenuFileExportJson}" Command="{Binding #MainWindowRoot.DataContext.ExportToJsonCommand}" InputGesture="Ctrl+E"/>
                    <MenuItem Header="{Binding MenuFileGenerateImportScript}" Command="{Binding #MainWindowRoot.DataContext.GenerateImportScriptCommand}" InputGesture="Ctrl+I"/>
                    <MenuItem Header="{Binding MenuFileExportReport}" Command="{Binding #MainWindowRoot.DataContext.ExportReportCommand}" InputGesture="Ctrl+Shift+R"/>
                    <MenuItem Header="{Binding MenuFileImportDescription}" Command="{Binding #MainWindowRoot.DataContext.ImportDescriptionCommand}" InputGesture="Ctrl+Shift+M"/>
                    <Separator/>
                    <MenuItem Header="{Binding MenuFileExit}" Click="OnExitClick" InputGesture="Alt+F4"/>
                </MenuItem>
                <MenuItem Header="{Binding MenuEdit}">
                    <MenuItem Header="{Binding MenuEditUndo}" Command="{Binding #MainWindowRoot.DataContext.UndoCommand}" InputGesture="Ctrl+Z"/>
                    <MenuItem Header="{Binding MenuEditRedo}" Command="{Binding #MainWindowRoot.DataContext.RedoCommand}" InputGesture="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="{Binding MenuEditCut}" Command="{Binding #MainWindowRoot.DataContext.CutObjectCommand}" InputGesture="Ctrl+X"/>
                    <MenuItem Header="{Binding MenuEditCopy}" Command="{Binding #MainWindowRoot.DataContext.CopyObjectCommand}" InputGesture="Ctrl+C"/>
                    <MenuItem Header="{Binding MenuEditPaste}" Command="{Binding #MainWindowRoot.DataContext.PasteObjectCommand}" InputGesture="Ctrl+V"/>
                    <Separator/>
                    <MenuItem Header="{Binding MenuEditRename}" Command="{Binding #MainWindowRoot.DataContext.RenameObjectCommand}" InputGesture="F2"/>
                    <MenuItem Header="{Binding MenuEditDelete}" Command="{Binding #MainWindowRoot.DataContext.DeleteObjectCommand}" InputGesture="Delete"/>
                    <Separator/>
                    <MenuItem Header="{Binding MenuEditAddPSO}" Command="{Binding #MainWindowRoot.DataContext.AddPasswordSettingsObjectCommand}"/>
                </MenuItem>
                <MenuItem Header="{Binding MenuView}">
                        <MenuItem Header="{Binding MenuViewExpandAll}" Command="{Binding #MainWindowRoot.DataContext.ExpandAllCommand}"/>
                        <MenuItem Header="{Binding MenuViewCollapseAll}" Command="{Binding #MainWindowRoot.DataContext.CollapseAllCommand}"/>
                        <Separator/>
                        <MenuItem Command="{Binding #MainWindowRoot.DataContext.ManageRelationsCommand}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🔗" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MenuViewManageRelations}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Header="{Binding MenuViewShowGraph}" Command="{Binding #MainWindowRoot.DataContext.ShowGraphViewCommand}"/>
                        <Separator/>
                        <MenuItem Header="{Binding MenuViewTheme}">
                            <MenuItem Header="{Binding MenuViewThemeLight}" Command="{Binding #MainWindowRoot.DataContext.SetThemeCommand}" CommandParameter="Light"/>
                            <MenuItem Header="{Binding MenuViewThemeDark}" Command="{Binding #MainWindowRoot.DataContext.SetThemeCommand}" CommandParameter="Dark"/>
                        </MenuItem>
                        <MenuItem Header="{Binding MenuViewLanguage}">
                            <MenuItem Header="{Binding MenuViewLanguageFrench}" Command="{Binding #MainWindowRoot.DataContext.SetLanguageCommand}" CommandParameter="fr-FR"/>
                            <MenuItem Header="{Binding MenuViewLanguageEnglish}" Command="{Binding #MainWindowRoot.DataContext.SetLanguageCommand}" CommandParameter="en-US"/>
                        </MenuItem>
                    </MenuItem>
                <MenuItem Header="{Binding MenuSettings}">
                    <MenuItem Header="{Binding MenuSettingsManageTiers}" Command="{Binding #MainWindowRoot.DataContext.ShowTierConfigurationCommand}"/>
                    <MenuItem Header="{Binding MenuSettingsApplyTierModel}" Command="{Binding #MainWindowRoot.DataContext.ApplyTierModelCommand}"/>
                    <MenuItem Header="{Binding MenuSettingsSilos}" Command="{Binding #MainWindowRoot.DataContext.ShowAuthenticationSilosCommand}"/>
                </MenuItem>
                <MenuItem Header="{Binding MenuAnalyse}">
                    <MenuItem Header="{Binding MenuAnalyseAudit}" Command="{Binding #MainWindowRoot.DataContext.ShowAuditCommand}" InputGesture="Ctrl+Shift+A"/>
                    <MenuItem Header="{Binding MenuAnalyseAttackPaths}" Command="{Binding #MainWindowRoot.DataContext.ShowAttackPathsCommand}" InputGesture="Ctrl+Shift+K"/>
                    <MenuItem Header="{Binding MenuAnalyseComparison}" Command="{Binding #MainWindowRoot.DataContext.ShowComparisonCommand}" InputGesture="Ctrl+Shift+B"/>
                    <MenuItem Header="{Binding MenuAnalyseMarkBaseline}" Command="{Binding #MainWindowRoot.DataContext.MarkBaselineCommand}"/>
                    <MenuItem Header="{Binding MenuAnalyseSimulateTiering}" Command="{Binding #MainWindowRoot.DataContext.SimulateTieringCommand}"/>
                    <Separator/>
                    <MenuItem Header="{Binding MenuAnalyseTimeline}" Command="{Binding #MainWindowRoot.DataContext.ShowTimelineCommand}" InputGesture="Ctrl+T"/>
                    <MenuItem Header="{Binding MenuAnalyseDelegations}" Command="{Binding #MainWindowRoot.DataContext.ShowDelegationsCommand}" InputGesture="Ctrl+D"/>
                    <Separator/>
                    <MenuItem Header="{Binding Source={StaticResource Loc}, Path=MenuSitesView}" Command="{Binding #MainWindowRoot.DataContext.ShowSitesCommand}" InputGesture="Ctrl+Shift+S"/>
                </MenuItem>
                <MenuItem Header="{Binding MenuLabs}">
                    <MenuItem Header="{Binding MenuLabsShowCurrent}" Command="{Binding #MainWindowRoot.DataContext.ShowCurrentLabCommand}"
                              IsVisible="{Binding #MainWindowRoot.DataContext.HasCurrentLab}"/>
                    <MenuItem Header="{Binding MenuLabsSaveSubmission}" Command="{Binding #MainWindowRoot.DataContext.SaveSubmissionCommand}"
                              IsVisible="{Binding #MainWindowRoot.DataContext.HasCurrentLab}"/>
                    <MenuItem Header="{Binding MenuLabsLeave}" Command="{Binding #MainWindowRoot.DataContext.LeaveLabModeCommand}"
                              IsVisible="{Binding #MainWindowRoot.DataContext.CanLeaveLabMode}"/>
                    <Separator IsVisible="{Binding #MainWindowRoot.DataContext.HasCurrentLab}"/>
                    <MenuItem Header="{Binding MenuLabsBuiltIn}" ItemsSource="{Binding #MainWindowRoot.DataContext.BuiltInLabs}" IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}">
                        <MenuItem.Styles>
                            <Style Selector="MenuItem > MenuItem" x:DataType="vm:LabMenuItem">
                                <Setter Property="Header" Value="{Binding Title}"/>
                                <Setter Property="Command" Value="{Binding #MainWindowRoot.DataContext.OpenBuiltInLabCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.Styles>
                    </MenuItem>
                    <MenuItem Header="{Binding MenuLabsAttackPaths}" ItemsSource="{Binding #MainWindowRoot.DataContext.AttackPathLabs}" IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}">
                        <MenuItem.Styles>
                            <Style Selector="MenuItem > MenuItem" x:DataType="vm:LabMenuItem">
                                <Setter Property="Header" Value="{Binding Title}"/>
                                <Setter Property="Command" Value="{Binding #MainWindowRoot.DataContext.OpenBuiltInLabCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.Styles>
                    </MenuItem>
                    <MenuItem Header="{Binding MenuLabsOpen}" Command="{Binding #MainWindowRoot.DataContext.OpenLabFileCommand}" IsVisible="{Binding #MainWindowRoot.DataContext.IsFreeMode}"/>
                </MenuItem>
                <MenuItem Header="{Binding MenuHelp}">
                    <MenuItem Header="{Binding MenuHelpShortcuts}" Command="{Binding #MainWindowRoot.DataContext.ShowShortcutsCommand}"/>
                    <MenuItem Header="{Binding MenuHelpAbout}" Command="{Binding #MainWindowRoot.DataContext.ShowAboutCommand}"/>
                </MenuItem>
            </Menu>
            </Grid>
          </Border>

          <!-- Barre d'outils : créer, supprimer, analyser, exporter -->
          <Border Classes="header" Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="6" x:Name="Toolbar" DataContext="{StaticResource Loc}">
                <Button Command="{Binding #MainWindowRoot.DataContext.AddOrganizationalUnitCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📁" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarOU}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.AddContainerCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📦" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarContainer}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.AddUserCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="👤" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarUser}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.AddGroupCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="👥" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarGroup}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.AddComputerCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="💻" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarComputer}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.AddGMSACommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🔐" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarGMSA}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.AddPolicyCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📋" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarPolicy}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.AddPasswordSettingsObjectCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🔑" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarPSO}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Classes="vrule"/>
                <Button Command="{Binding #MainWindowRoot.DataContext.DeleteObjectCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🗑️" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarDelete}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Classes="vrule"/>
                <Button Command="{Binding #MainWindowRoot.DataContext.ManageRelationsCommand}"
                        Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🔗" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarRelations}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.ShowGraphViewCommand}"
                        Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🕸️" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarGraph}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding #MainWindowRoot.DataContext.ShowAuditCommand}" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🛡️" FontSize="14"/>
                        <TextBlock Text="{Binding MenuAnalyseAudit}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Classes="vrule"/>
                <Button Click="OnExportTreePngClick" Classes="tool">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📷" FontSize="14"/>
                        <TextBlock Text="{Binding ToolbarExportPNG}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Zone principale : l'arbre de l'annuaire, puis les détails de l'objet choisi, une carte par sujet -->
        <Grid Grid.Row="1" ColumnDefinitions="400,12,*" Margin="16,14,16,14">
            <!-- Arbre -->
            <Border Grid.Column="0" Classes="card" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*,Auto" DataContext="{StaticResource Loc}">
                    <TextBlock Grid.Row="0" Classes="h" Text="{Binding TreeViewTitle}" Margin="4,0,0,10"/>

                    <!-- ═══ BARRE DE RECHERCHE ═══ -->
                    <Border Grid.Row="1" Margin="0,0,0,8" CornerRadius="8" Background="{DynamicResource CodeBg}"
                            BorderThickness="1" BorderBrush="{DynamicResource AppSeparatorBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                                       FontFamily="Segoe UI Emoji"
                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                       Foreground="{DynamicResource AppTreeFgBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding #MainWindowRoot.DataContext.SearchText, Mode=TwoWay}"
                                     PlaceholderText="{Binding SearchPlaceholder}"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="2,6" FontSize="13"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    Command="{Binding #MainWindowRoot.DataContext.ClearSearchCommand}"
                                    IsVisible="{Binding #MainWindowRoot.DataContext.SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6,4" FontSize="11"
                                    Foreground="{DynamicResource AppTreeFgBrush}"
                                    ToolTip.Tip="{Binding TooltipClearSearch}"/>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="2"
                              x:Name="MainTreeView"
                              ItemsSource="{Binding #MainWindowRoot.DataContext.RootNodes}"
                              SelectedItem="{Binding #MainWindowRoot.DataContext.SelectedNode, Mode=TwoWay}">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <!-- Ajouter OU -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddOU}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddOrganizationalUnitCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddOU}">
                                    <MenuItem.Icon><TextBlock Text="📁" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter Container -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddContainer}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddContainerCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddContainer}">
                                    <MenuItem.Icon><TextBlock Text="📦" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter Utilisateur -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddUser}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddUserCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddUser}">
                                    <MenuItem.Icon><TextBlock Text="👤" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter Groupe -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddGroup}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddGroupCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddGroup}">
                                    <MenuItem.Icon><TextBlock Text="👥" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter Ordinateur -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddComputer}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddComputerCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddComputer}">
                                    <MenuItem.Icon><TextBlock Text="💻" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter GMSA -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddGMSA}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddGMSACommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddGMSA}">
                                    <MenuItem.Icon><TextBlock Text="🔐" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter GPO -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddPolicy}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddPolicyCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddPolicy}">
                                    <MenuItem.Icon><TextBlock Text="📋" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter PSO -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddPSO}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddPasswordSettingsObjectCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddPSO}">
                                    <MenuItem.Icon><TextBlock Text="🔑" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Séparateur entre ajout enfant et actions objet -->
                                <Separator IsVisible="{Binding #MainWindowRoot.DataContext.CanAddAnyChild}"/>
                                <!-- Ajouter au groupe (User / Computer / GMSA) -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddToGroup}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddToGroupCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddToGroup}">
                                    <MenuItem.Icon><TextBlock Text="👥" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Ajouter des membres (Group) -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddMember}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddMemberCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddMember}">
                                    <MenuItem.Icon><TextBlock Text="👤" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Imbrication groupe dans groupe -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuAddGroupToGroup}"
                                          Command="{Binding #MainWindowRoot.DataContext.AddGroupToGroupCommand}"
                                          IsVisible="{Binding #MainWindowRoot.DataContext.CanAddGroupToGroup}">
                                    <MenuItem.Icon><TextBlock Text="👥" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Séparateur avant édition -->
                                <Separator IsVisible="{Binding #MainWindowRoot.DataContext.CanAddToGroup}"/>
                                <Separator IsVisible="{Binding #MainWindowRoot.DataContext.CanAddMember}"/>
                                <!-- Renommer -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuRename}"
                                          Command="{Binding #MainWindowRoot.DataContext.RenameObjectCommand}"
                                          IsEnabled="{Binding #MainWindowRoot.DataContext.CanCopySelected}">
                                    <MenuItem.Icon><TextBlock Text="✏️" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Couper (déplacer) -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuCut}"
                                          Command="{Binding #MainWindowRoot.DataContext.CutObjectCommand}"
                                          IsEnabled="{Binding #MainWindowRoot.DataContext.CanCutSelected}">
                                    <MenuItem.Icon><TextBlock Text="✂️" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Copier -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuCopy}"
                                          Command="{Binding #MainWindowRoot.DataContext.CopyObjectCommand}"
                                          IsEnabled="{Binding #MainWindowRoot.DataContext.CanCopySelected}">
                                    <MenuItem.Icon><TextBlock Text="📋" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Coller -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuPaste}"
                                          Command="{Binding #MainWindowRoot.DataContext.PasteObjectCommand}"
                                          IsEnabled="{Binding #MainWindowRoot.DataContext.CanCopySelected}">
                                    <MenuItem.Icon><TextBlock Text="📌" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <!-- Supprimer -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuDelete}"
                                          Command="{Binding #MainWindowRoot.DataContext.DeleteObjectCommand}"
                                          IsEnabled="{Binding #MainWindowRoot.DataContext.CanDeleteSelected}">
                                    <MenuItem.Icon><TextBlock Text="🗑️" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <!-- Gérer les relations -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=ContextMenuManageRelations}"
                                          Command="{Binding #MainWindowRoot.DataContext.ManageRelationsCommand}"
                                          IsEnabled="{Binding #MainWindowRoot.DataContext.CanManageRelations}">
                                    <MenuItem.Icon><TextBlock Text="🔗" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <!-- Importer description markdown -->
                                <MenuItem Header="{Binding Source={StaticResource Loc}, Path=MenuFileImportDescription}"
                                          Command="{Binding #MainWindowRoot.DataContext.ImportDescriptionCommand}"
                                          IsEnabled="{Binding #MainWindowRoot.DataContext.CanCopySelected}">
                                    <MenuItem.Icon><TextBlock Text="📥" FontSize="14" FontFamily="Segoe UI Emoji"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" FontFamily="Segoe UI Emoji,Apple Color Emoji,Noto Color Emoji"/>
                                    <TextBlock Text="{Binding Data.Name}" VerticalAlignment="Center"/>
                                    <Border IsVisible="{Binding Data.Tier, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Background="#22000000" CornerRadius="3" Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Data.Tier}"
                                                   Foreground="{Binding TierColor}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <!-- Badge GPO lié -->
                                    <Border IsVisible="{Binding HasLinkedGPOs}"
                                            Background="#1A6B2F" CornerRadius="3" Padding="4,1"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding LinkedGPOsSummary}">
                                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=BadgeGpo}"
                                                   Foreground="#7FFF9A"
                                                   FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                    <!-- Badge Délégations -->
                                    <Border IsVisible="{Binding HasDelegations}"
                                            Background="#7B5800" CornerRadius="3" Padding="4,1"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding DelegationsSummary}">
                                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=BadgeDelegations}"
                                                   Foreground="#FFD87F"
                                                   FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                    <!-- Badge Audit (après lancement de l'audit) -->
                                    <Border IsVisible="{Binding HasAuditFindings}"
                                            Background="{Binding AuditBadgeColor}" CornerRadius="3" Padding="4,1"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding AuditTooltip}">
                                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=BadgeAudit}"
                                                   Foreground="White"
                                                   FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- ═══ SECTION SITES AD ═══ -->
                    <StackPanel Grid.Row="3" Margin="0,6,0,0"
                                IsVisible="{Binding #MainWindowRoot.DataContext.SitesTopology, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- Header: full-width clickable strip -->
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="6,5"
                                Background="{DynamicResource ChipBg}"
                                BorderThickness="0" CornerRadius="8"
                                Command="{Binding #MainWindowRoot.DataContext.ToggleSitesExpandedCommand}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="🏢" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SitesPanelTitle}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTreeFgBrush}"/>
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="999" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding #MainWindowRoot.DataContext.SiteRootNodes.Count}"
                                                   Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="∧" VerticalAlignment="Center" Margin="0,0,4,0"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AppTreeFgBrush}"
                                           IsVisible="{Binding #MainWindowRoot.DataContext.IsSitesExpanded}"/>
                                <TextBlock Grid.Column="1" Text="∨" VerticalAlignment="Center" Margin="0,0,4,0"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AppTreeFgBrush}"
                                           IsVisible="{Binding !#MainWindowRoot.DataContext.IsSitesExpanded}"/>
                            </Grid>
                        </Button>

                        <!-- Collapsible content -->
                        <ScrollViewer MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding #MainWindowRoot.DataContext.IsSitesExpanded}">
                            <TreeView ItemsSource="{Binding #MainWindowRoot.DataContext.SiteRootNodes}"
                                      HorizontalAlignment="Stretch">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="vm:SiteTreeNode"
                                                      ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji"
                                                       FontSize="14" VerticalAlignment="Center"
                                                       IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Séparateur -->
            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Détails de l'objet : une carte par sujet -->
            <ScrollViewer Grid.Column="2" Padding="0,0,8,0">
                <StackPanel Spacing="14" DataContext="{StaticResource Loc}">
                    <!-- L'objet et ses actions -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="h" Text="{Binding DetailsTitle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="tool" Content="{Binding ActionRename}" Command="{Binding #MainWindowRoot.DataContext.RenameObjectCommand}"/>
                                    <Button Classes="tool" Content="{Binding ActionCopy}" Command="{Binding #MainWindowRoot.DataContext.CopyObjectCommand}"/>
                                    <Button Classes="danger" Content="{Binding ActionDelete}" Command="{Binding #MainWindowRoot.DataContext.DeleteObjectCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="label" Text="{Binding FieldName}"/>
                                    <!-- Validé par Entrée ou en quittant le champ, pas à chaque frappe ; Échap annule (voir le code-behind) -->
                                    <TextBox x:Name="ObjectNameBox"
                                         Text="{Binding #MainWindowRoot.DataContext.SelectedObjectName, Mode=OneWay}"
                                         KeyDown="OnObjectNameKeyDown"
                                         LostFocus="OnObjectNameLostFocus"
                                         helpers:FocusExtensions.IsFocused="{Binding #MainWindowRoot.DataContext.SelectedNode.IsEditing, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Classes="label" Text="{Binding FieldType}"/>
                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedObjectType}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="5">
                                    <TextBlock Classes="label" Text="{Binding FieldDN}"/>
                                    <TextBox Classes="mono" Text="{Binding #MainWindowRoot.DataContext.SelectedObjectDistinguishedName}"
                                             IsReadOnly="True" TextWrapping="Wrap" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Spacing="5">
                                    <TextBlock Classes="label" Text="{Binding FieldTier}"/>
                                    <ComboBox x:Name="TierComboBox"
                                              SelectedIndex="{Binding #MainWindowRoot.DataContext.SelectedObjectTierIndex, Mode=OneWay}"
                                              ItemsSource="{Binding #MainWindowRoot.DataContext.AvailableTiers}"
                                              SelectionChanged="OnTierComboBoxSelectionChanged"
                                              Width="200" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Description -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="h" Text="{Binding FieldDescription}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="tool" Command="{Binding #MainWindowRoot.DataContext.ImportDescriptionCommand}"
                                            ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=MenuFileImportDescription}"
                                            IsEnabled="{Binding #MainWindowRoot.DataContext.CanCopySelected}">
                                        <TextBlock Text="📥" FontFamily="Segoe UI Emoji" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Classes="tool" Command="{Binding #MainWindowRoot.DataContext.ToggleMarkdownEditCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock Text="{Binding DetailsEdit}" IsVisible="{Binding !#MainWindowRoot.DataContext.IsMarkdownEditMode}"/>
                                            <TextBlock Text="{Binding DetailsPreview}" IsVisible="{Binding #MainWindowRoot.DataContext.IsMarkdownEditMode}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedObjectDescription, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="300"
                                     IsVisible="{Binding #MainWindowRoot.DataContext.IsMarkdownEditMode}"/>
                            <Border Classes="code" Padding="14,10" Height="300"
                                    IsVisible="{Binding !#MainWindowRoot.DataContext.IsMarkdownEditMode}">
                                <ScrollViewer>
                                    <ContentControl Content="{Binding #MainWindowRoot.DataContext.SelectedObjectDescription, Converter={StaticResource MarkdownConverter}}"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                                            <!-- ===== SÉCURITÉ : comptes (User/Computer/GMSA), groupes et GPO ===== -->
                                            <Border Classes="card" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.HasSecurityAttributes, FallbackValue=False}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="h" Text="{Binding DetailsSecurity}"/>

                                                <!-- Drapeaux userAccountControl -->
                                                <StackPanel Spacing="2" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.IsAccount, FallbackValue=False}">
                                                    <CheckBox Content="{Binding SecurityAccountDisabled}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.AccountDisabled, Mode=TwoWay}"/>
                                                    <CheckBox Content="{Binding SecurityPasswordNotRequired}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.PasswordNotRequired, Mode=TwoWay}"/>
                                                    <CheckBox Content="{Binding SecurityPasswordNeverExpires}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.PasswordNeverExpires, Mode=TwoWay}"/>
                                                    <CheckBox Content="{Binding SecurityDontRequirePreauth}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.DontRequirePreauth, Mode=TwoWay}"/>
                                                    <CheckBox Content="{Binding SecurityTrustedForDelegation}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.TrustedForDelegation, Mode=TwoWay}"/>
                                                    <CheckBox Content="{Binding SecurityTrustedToAuthForDelegation}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.TrustedToAuthForDelegation, Mode=TwoWay}"/>
                                                    <CheckBox Content="{Binding SecurityNotDelegated}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.NotDelegated, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.SiloEffect}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.HasSiloEffect, FallbackValue=False}"/>

                                                    <TextBlock Text="{Binding SecuritySpn}" Margin="0,6,0,0"/>
                                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.ServicePrincipalNamesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60" MaxHeight="140"
                                                             FontFamily="Consolas, Courier New, monospace" FontSize="12"/>

                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8" Margin="0,6,0,0">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SecurityPwdLastSet}" VerticalAlignment="Center"/>
                                                        <CalendarDatePicker Grid.Row="0" Grid.Column="1" Width="160"
                                                                            SelectedDate="{Binding #MainWindowRoot.DataContext.SelectedSecurity.PwdLastSet, Mode=TwoWay}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SecurityLastLogon}" VerticalAlignment="Center"/>
                                                        <CalendarDatePicker Grid.Row="1" Grid.Column="1" Width="160"
                                                                            SelectedDate="{Binding #MainWindowRoot.DataContext.SelectedSecurity.LastLogonTimestamp, Mode=TwoWay}"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding SecurityAllowedToDelegateTo}" Margin="0,6,0,0"/>
                                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.AllowedToDelegateToText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40" MaxHeight="120"
                                                             FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                </StackPanel>

                                                <!-- Ordinateur : LAPS, administrateurs locaux, sessions -->
                                                <StackPanel Spacing="4" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.IsComputer, FallbackValue=False}">
                                                    <TextBlock Text="{Binding SecurityComputer}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                    <CheckBox Content="{Binding SecurityLaps}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.Laps, Mode=TwoWay}"/>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                                          IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.Laps, FallbackValue=False}">
                                                        <TextBlock Grid.Column="0" Text="{Binding SecurityLapsExpiration}" VerticalAlignment="Center"/>
                                                        <CalendarDatePicker Grid.Column="1" Width="160"
                                                                            SelectedDate="{Binding #MainWindowRoot.DataContext.SelectedSecurity.LapsPasswordExpiration, Mode=TwoWay}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SecurityLocalAdmins}" Margin="0,4,0,0"/>
                                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.LocalAdminsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40" MaxHeight="120"
                                                             FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                    <TextBlock Text="{Binding SecuritySessions}" Margin="0,4,0,0"/>
                                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.SessionsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40" MaxHeight="120"
                                                             FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                    <!-- Effets des GPO qui s'appliquent à la machine (calculés à la sélection) -->
                                                    <StackPanel Spacing="2" Margin="0,4,0,0"
                                                                IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.HasGpoLocalAdminsEffect, FallbackValue=False}">
                                                        <TextBlock Text="{Binding SecurityGpoLocalAdminsEffect}"/>
                                                        <TextBlock Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GpoLocalAdminsEffect}" TextWrapping="Wrap"
                                                                   FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="2" Margin="0,4,0,0"
                                                                IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.HasBlockedSessionsEffect, FallbackValue=False}">
                                                        <TextBlock Text="{Binding SecurityBlockedSessions}"/>
                                                        <TextBlock Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.BlockedSessionsEffect}" TextWrapping="Wrap"
                                                                   FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- GPO : refus d'ouverture de session, administrateurs locaux, filtre WMI -->
                                                <StackPanel Spacing="4" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.IsPolicy, FallbackValue=False}">
                                                    <TextBlock Text="{Binding SecurityGpo}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding SecurityGpoNote}" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
                                                    <TextBlock Text="{Binding SecurityGpoDenyInteractiveLogon}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GpoDenyInteractiveLogonText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40" MaxHeight="140"
                                                             FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                    <TextBlock Text="{Binding SecurityGpoDenyRemoteInteractiveLogon}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GpoDenyRemoteInteractiveLogonText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40" MaxHeight="140"
                                                             FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                    <TextBlock Text="{Binding SecurityGpoLocalAdmins}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBox Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GpoLocalAdminsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40" MaxHeight="120"
                                                             FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                                    <CheckBox Content="{Binding SecurityGpoReplaceLocalAdmins}"
                                                              IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GpoReplaceLocalAdmins, Mode=TwoWay}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding SecurityGpoComputerFilter}" VerticalAlignment="Center"/>
                                                        <ComboBox Width="180"
                                                                  ItemsSource="{x:Static vm:ObjectSecurityViewModel.GpoComputerFilters}"
                                                                  SelectedItem="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GpoComputerFilterChoice, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock>
                                                                        <TextBlock.Text>
                                                                            <MultiBinding Converter="{StaticResource LocValue}" ConverterParameter="GpoComputerFilter">
                                                                                <Binding/>
                                                                                <Binding Source="{StaticResource Loc}" Path="CurrentCulture"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Spacing="2" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.HasGpoWmiQuery, FallbackValue=False}">
                                                        <TextBlock Text="{Binding SecurityGpoWmiQuery}" FontSize="11" Opacity="0.8"/>
                                                        <TextBlock Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GpoWmiQuery}" TextWrapping="Wrap"
                                                                   FontFamily="Consolas, Courier New, monospace" FontSize="11" Opacity="0.8"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Groupes -->
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8"
                                                      IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.IsGroup, FallbackValue=False}">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SecurityGroupScope}" VerticalAlignment="Center"/>
                                                    <!-- Valeurs traduites ; la culture dans la MultiBinding les recalcule au changement de langue -->
                                                    <ComboBox Grid.Row="0" Grid.Column="1" Width="160"
                                                              ItemsSource="{x:Static vm:ObjectSecurityViewModel.GroupScopes}"
                                                              SelectedItem="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GroupScope, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource LocValue}" ConverterParameter="GroupScope">
                                                                            <Binding/>
                                                                            <Binding Source="{StaticResource Loc}" Path="CurrentCulture"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SecurityGroupCategory}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Row="1" Grid.Column="1" Width="160"
                                                              ItemsSource="{x:Static vm:ObjectSecurityViewModel.GroupCategories}"
                                                              SelectedItem="{Binding #MainWindowRoot.DataContext.SelectedSecurity.GroupCategory, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource LocValue}" ConverterParameter="GroupCategory">
                                                                            <Binding/>
                                                                            <Binding Source="{StaticResource Loc}" Path="CurrentCulture"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>

                                                <CheckBox Content="{Binding SecurityAdminCount}"
                                                          IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSecurity.HasAdminCount, FallbackValue=False}"
                                                          IsChecked="{Binding #MainWindowRoot.DataContext.SelectedSecurity.AdminCount, Mode=TwoWay}"/>

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SecurityOwner}" VerticalAlignment="Center"/>
                                                    <TextBox Width="220"
                                                             Text="{Binding #MainWindowRoot.DataContext.SelectedSecurity.Owner, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            </Border>
                                            <!-- MemberOf : User ou Groupe -->
                                            <Border Classes="card" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSupportsMemberOf}">
                                            <StackPanel Spacing="8">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=DetailsMemberOf}" Classes="h" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                    <Button Content="{Binding Source={StaticResource Loc}, Path=ActionManage}" DockPanel.Dock="Right"
                                                            Command="{Binding #MainWindowRoot.DataContext.ManageRelationsCommand}"
                                                            Classes="tool"/>
                                                </DockPanel>
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding #MainWindowRoot.DataContext.SelectedMemberOf}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ChipBg}" CornerRadius="6" Padding="8,4" Margin="0,2">
                                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                            </Border>
                                            <!-- LinkedGPOs : OU -->
                                            <Border Classes="card" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedSupportsGpoLinks}">
                                            <StackPanel Spacing="8">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=DetailsLinkedGPOs}" Classes="h" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                    <Button Content="{Binding Source={StaticResource Loc}, Path=ActionManage}" DockPanel.Dock="Right"
                                                            Command="{Binding #MainWindowRoot.DataContext.ManageRelationsCommand}"
                                                            Classes="tool"/>
                                                </DockPanel>
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding #MainWindowRoot.DataContext.SelectedLinkedGPOs}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ChipBg}" CornerRadius="6" Padding="8,4" Margin="0,2">
                                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                            </Border>
                                            <!-- PSO subjects -->
                                            <Border Classes="card" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedIsPso}">
                                            <StackPanel Spacing="8">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=DetailsPSOAppliesTo}" Classes="h" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                    <Button Content="{Binding Source={StaticResource Loc}, Path=ActionManage}" DockPanel.Dock="Right"
                                                            Command="{Binding #MainWindowRoot.DataContext.ManageRelationsCommand}"
                                                            Classes="tool"/>
                                                </DockPanel>
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding #MainWindowRoot.DataContext.SelectedPSOAppliesTo}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ChipBg}" CornerRadius="6" Padding="8,4" Margin="0,2">
                                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                            </Border>
                                            <!-- ===== Politique de mot de passe : domaine (Default Domain Policy) et PSO ===== -->
                                            <Border Classes="card" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="h" Text="{Binding DetailsPasswordPolicy}"/>
                                                <TextBlock Text="{Binding DetailsPasswordPolicyHint}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                                <DockPanel IsVisible="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.IsPso, FallbackValue=False}">
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.Precedence, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyPrecedence}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.MinPasswordLength, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyMinLength}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.PasswordHistoryCount, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyHistory}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.MaxPasswordAgeDays, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyMaxAge}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.MinPasswordAgeDays, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyMinAge}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.LockoutThreshold, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyLockoutThreshold}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.LockoutDurationMinutes, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyLockoutDuration}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.LockoutObservationWindowMinutes, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding PolicyObservation}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <CheckBox Content="{Binding PolicyComplexity}"
                                                          IsChecked="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.ComplexityEnabled, Mode=TwoWay, FallbackValue=False}"/>
                                                <!-- Domaine seulement : ms-DS-MachineAccountQuota -->
                                                <DockPanel Margin="0,6,0,0" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.IsDomain, FallbackValue=False}">
                                                    <NumericUpDown DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="100000" FormatString="0"
                                                                   Value="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.MachineAccountQuota, Mode=TwoWay}"/>
                                                    <TextBlock Text="{Binding DomainMachineAccountQuota}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <!-- Domaine seulement : version de Windows Server qui l'a promu -->
                                                <DockPanel Margin="0,6,0,0" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.ServerVersionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                                                    <TextBlock DockPanel.Dock="Right" Width="120" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Text="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.ServerVersionName}"/>
                                                    <TextBlock Text="{Binding DomainServerVersion}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <!-- Domaine seulement : modèle de cloisonnement appliqué -->
                                                <DockPanel Margin="0,6,0,0" IsVisible="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.TierModelName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                                                    <TextBlock DockPanel.Dock="Right" Width="120" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Text="{Binding #MainWindowRoot.DataContext.SelectedPasswordPolicy.TierModelName}"/>
                                                    <TextBlock Text="{Binding DomainTierModel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </StackPanel>
                                            </Border>
                </StackPanel>
            </ScrollViewer>
                        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="2" Classes="footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="muted" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ObjectCountsSummary}" VerticalAlignment="Center" FontSize="11" Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
