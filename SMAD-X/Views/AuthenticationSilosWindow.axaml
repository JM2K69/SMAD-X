<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        x:Class="SMADX.Views.AuthenticationSilosWindow"
        x:DataType="vm:AuthenticationSilosViewModel"
        Title="{Binding Source={StaticResource Loc}, Path=DialogSilosTitle}"
        Icon="/Assets/icone.ico"
        Width="1000" Height="680"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosDescription}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" ColumnDefinitions="200,*" ColumnSpacing="12">

            <!-- ═══ Les silos du domaine ═══ -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosAdd}" Command="{Binding AddCommand}" Padding="10,4"/>
                    <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosRemove}" Command="{Binding RemoveCommand}" Padding="10,4"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Silos}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SiloItem">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Opacity="0.8">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocValue}" ConverterParameter="Dialog.Silos.Mode">
                                            <Binding Path="Enforced"/>
                                            <Binding Source="{StaticResource Loc}" Path="CurrentCulture"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ═══ Le silo sélectionné : identités et ordinateurs ═══ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" IsVisible="{Binding HasSelection}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,2*" ColumnSpacing="8" RowSpacing="4">
                    <TextBlock Grid.Column="0" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosName}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Selected.Name, FallbackValue=''}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosDescriptionField}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Text="{Binding Selected.Description, FallbackValue=''}"/>
                </Grid>
                <CheckBox Grid.Row="1" Content="{Binding Source={StaticResource Loc}, Path=DialogSilosEnforced}"
                          IsChecked="{Binding Selected.Enforced, FallbackValue=False}" Margin="0,6,0,6"/>

                <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Identités -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosMembers}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosBrowse}" Click="OnPickMembers" Padding="10,4"/>
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosRemoveEntry}" Command="{Binding RemoveMemberCommand}" Padding="10,4"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Selected.Members}" SelectedItem="{Binding Selected.SelectedMember}"/>
                    </DockPanel>
                    <!-- Ordinateurs -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosComputers}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosBrowse}" Click="OnPickComputers" Padding="10,4"/>
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosRemoveEntry}" Command="{Binding RemoveComputerCommand}" Padding="10,4"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Selected.Computers}" SelectedItem="{Binding Selected.SelectedComputer}"/>
                    </DockPanel>
                </Grid>

                <TextBlock Grid.Row="5" Text="{Binding ProtectedUsersWarning}" IsVisible="{Binding HasProtectedUsersWarning}"
                           Foreground="#D35400" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosOk}" Click="OnOkClick" Padding="14,5"/>
                <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosCancel}" Click="OnCancelClick" Padding="14,5"/>
            </StackPanel>
            <TextBlock x:Name="ErrorTextBlock" Foreground="#C0392B" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
