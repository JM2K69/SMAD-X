<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        x:Class="SMADX.Views.AuthenticationSilosWindow"
        x:DataType="vm:AuthenticationSilosViewModel"
        Title="{Binding Source={StaticResource Loc}, Path=DialogSilosTitle}"
        Icon="/Assets/icone.ico"
        Width="1000" Height="680"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0" Classes="muted" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosDescription}" FontSize="13" Margin="2,0,0,12"/>

        <Grid Grid.Row="1" ColumnDefinitions="200,*" ColumnSpacing="12">

            <!-- ═══ Les silos du domaine ═══ -->
            <Border Grid.Column="0" Classes="card" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosAdd}" Command="{Binding AddCommand}" Classes="tool"/>
                    <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosRemove}" Command="{Binding RemoveCommand}" Classes="tool"/>
                </StackPanel>
                <ListBox Classes="plain" ItemsSource="{Binding Silos}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SiloItem">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocValue}" ConverterParameter="Dialog.Silos.Mode">
                                            <Binding Path="Enforced"/>
                                            <Binding Source="{StaticResource Loc}" Path="CurrentCulture"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Border>

            <!-- ═══ Le silo sélectionné : identités et ordinateurs ═══ -->
            <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasSelection}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,2*" ColumnSpacing="8" RowSpacing="4">
                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosName}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Selected.Name, FallbackValue=''}"/>
                    <TextBlock Grid.Column="2" Classes="label" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosDescriptionField}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Text="{Binding Selected.Description, FallbackValue=''}"/>
                </Grid>
                <CheckBox Grid.Row="1" Content="{Binding Source={StaticResource Loc}, Path=DialogSilosEnforced}"
                          IsChecked="{Binding Selected.Enforced, FallbackValue=False}" Margin="0,6,0,6"/>

                <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Identités -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Classes="label" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosMembers}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosBrowse}" Click="OnPickMembers" Classes="tool"/>
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosRemoveEntry}" Command="{Binding RemoveMemberCommand}" Classes="tool"/>
                        </StackPanel>
                        <ListBox Classes="plain" Background="{DynamicResource CodeBg}" CornerRadius="8" ItemsSource="{Binding Selected.Members}" SelectedItem="{Binding Selected.SelectedMember}"/>
                    </DockPanel>
                    <!-- Ordinateurs -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Classes="label" Text="{Binding Source={StaticResource Loc}, Path=DialogSilosComputers}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosBrowse}" Click="OnPickComputers" Classes="tool"/>
                            <Button Content="{Binding Source={StaticResource Loc}, Path=DialogSilosRemoveEntry}" Command="{Binding RemoveComputerCommand}" Classes="tool"/>
                        </StackPanel>
                        <ListBox Classes="plain" Background="{DynamicResource CodeBg}" CornerRadius="8" ItemsSource="{Binding Selected.Computers}" SelectedItem="{Binding Selected.SelectedComputer}"/>
                    </DockPanel>
                </Grid>

                <TextBlock Grid.Row="5" Text="{Binding ProtectedUsersWarning}" IsVisible="{Binding HasProtectedUsersWarning}"
                           Foreground="#D35400" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{Binding Source={StaticResource Loc}, Path=DialogSilosOk}" Click="OnOkClick" MinWidth="90" HorizontalContentAlignment="Center"/>
                <Button Classes="tool" Content="{Binding Source={StaticResource Loc}, Path=DialogSilosCancel}" Click="OnCancelClick" MinWidth="90" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="ErrorTextBlock" Foreground="#C0392B" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
