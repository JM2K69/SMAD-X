<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        x:Class="SMADX.Views.AttackPathsWindow"
        x:Name="AttackPathsWindowRoot"
        x:DataType="vm:AttackPathsViewModel"
        Title="{Binding Source={StaticResource Loc}, Path=AttackPathTitle}"
        Icon="/Assets/icone.ico"
        Width="1150" Height="760"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- ═══ Présentation et options ═══ -->
        <Border Grid.Row="0" Classes="card" Padding="18,14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="muted" Text="{Binding Source={StaticResource Loc}, Path=AttackPathIntro}" FontSize="13"/>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="10,0,0,0">
                    <CheckBox Content="{Binding Source={StaticResource Loc}, Path=AttackPathShowTier0}" IsChecked="{Binding ShowTier0}"/>
                    <Button Classes="tool" Content="{Binding Source={StaticResource Loc}, Path=AttackPathRefresh}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="4*,12,7*">

            <!-- Sources -->
            <Border Grid.Column="0" Classes="card" Padding="8,14,8,8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h" Text="{Binding Source={StaticResource Loc}, Path=AttackPathSources}" Margin="8,0,0,8"/>
                    <ListBox Grid.Row="1" Classes="plain" ItemsSource="{Binding Paths}" SelectedItem="{Binding SelectedPath}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttackPathItem">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Classes="muted" Text="{Binding Tier}" FontSize="11"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#C0392B" CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StepCountLabel}" Foreground="White" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>

            <!-- Étapes -->
            <Border Grid.Column="2" Classes="card" Padding="8,14,8,8">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Classes="h" Text="{Binding Source={StaticResource Loc}, Path=AttackPathSteps}" Margin="8,0,0,8"/>
                    <TextBlock Grid.Row="1" Text="{Binding Source={StaticResource Loc}, Path=AttackPathNone}" IsVisible="{Binding HasNoPath}"
                               Foreground="#27AE60" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="8,4"/>
                    <ListBox Grid.Row="1" Classes="plain" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" IsVisible="{Binding HasSelection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttackStepItem">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                    <Border Grid.Column="0" Background="#C0392B" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding From}" FontWeight="SemiBold"/>
                                            <Run Text="  →  " Foreground="#E74C3C"/>
                                            <Run Text="{Binding To}" FontWeight="SemiBold"/>
                                            <Run Text="   "/>
                                            <Run Text="{Binding KindLabel}" Foreground="#E67E22"/>
                                        </TextBlock>
                                        <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,6,4">
                        <Button Classes="tool" Content="{Binding Source={StaticResource Loc}, Path=AuditSelectInTree}" Command="{Binding ShowInTreeCommand}"/>
                        <Button Classes="accent" Content="{Binding Source={StaticResource Loc}, Path=AttackPathShowInGraph}" Command="{Binding ShowInGraphCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
