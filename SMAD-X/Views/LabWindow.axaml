<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        x:Class="SMADX.Views.LabWindow"
        x:Name="LabWindowRoot"
        x:DataType="vm:LabViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icone.ico"
        Width="1100" Height="820"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- ═══ En-tête : titre, niveau, durée, score ═══ -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#2E86C1" CornerRadius="10" Padding="10,2">
                            <TextBlock Text="{Binding LevelLabel}" Foreground="White" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding DurationLabel}" VerticalAlignment="Center" Opacity="0.8"/>
                        <TextBlock Text="{Binding ElapsedLabel}" VerticalAlignment="Center" Opacity="0.8" IsVisible="{Binding !IsOverTime}"/>
                        <TextBlock Text="{Binding ElapsedLabel}" VerticalAlignment="Center" Foreground="#C0392B" FontWeight="SemiBold" IsVisible="{Binding IsOverTime}"/>
                    </StackPanel>
                    <!-- Mode examen : ni indice, ni vérification -->
                    <Border Background="#40C0392B" CornerRadius="4" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Left"
                            IsVisible="{Binding IsExam}">
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=LabExamNotice}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding ShowGrading}">
                    <TextBlock Text="{Binding ScoreLabel}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=LabCompleted}" Foreground="#27AE60" FontWeight="SemiBold"
                               IsVisible="{Binding IsCompleted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Énoncé | objectifs ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="5*,Auto,6*">
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer>
                    <ContentControl Content="{Binding Statement, Converter={StaticResource MarkdownConverter}}"/>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" Background="Transparent"/>

            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="10">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=LabObjectives}" FontWeight="SemiBold" FontSize="15" Margin="4,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Objectives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LabObjectiveItem">
                                    <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="4,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}"
                                                       FontSize="18" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{Binding StatusColor}" IsVisible="{Binding Passed, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                <Border Background="#202E86C1" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsHintVisible}">
                                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="12"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4" Margin="10,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Opacity="0.8" IsVisible="{Binding IsScored}">
                                                    <Run Text="{Binding Points}"/><Run Text="{Binding Source={StaticResource Loc}, Path=LabPointsUnit}"/>
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Opacity="0.8" IsVisible="{Binding IsGuard}"
                                                           Text="{Binding Source={StaticResource Loc}, Path=LabGuard}"
                                                           ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=LabGuardTip}"/>
                                                <Button Content="{Binding Source={StaticResource Loc}, Path=LabHint}" Command="{Binding ToggleHintCommand}"
                                                        Padding="8,2" FontSize="11" IsVisible="{Binding CanShowHint}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Questions de compréhension : la réponse s'enregistre dans la copie -->
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=LabQuestions}" FontWeight="SemiBold" FontSize="15" Margin="4,16,0,8"
                                   IsVisible="{Binding HasQuestions}"/>
                        <ItemsControl ItemsSource="{Binding Questions}" IsVisible="{Binding HasQuestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LabQuestionItem">
                                    <Border BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="4,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}"
                                                       FontSize="18" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsSingleChoice}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:LabChoiceItem">
                                                            <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsSelected}">
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                            </RadioButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsMultipleChoice}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:LabChoiceItem">
                                                            <CheckBox IsChecked="{Binding IsSelected}">
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Prompts}" IsVisible="{Binding IsMatching}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:LabPromptItem">
                                                            <Grid ColumnDefinitions="*,Auto,*" Margin="0,2">
                                                                <TextBlock Grid.Column="0" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="→" Margin="8,0" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBox Text="{Binding Text}" IsVisible="{Binding IsText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"
                                                         PlaceholderText="{Binding Source={StaticResource Loc}, Path=LabAnswerWatermark}"/>
                                                <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{Binding StatusColor}" IsVisible="{Binding Feedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <Border Background="#202E86C1" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsHintVisible}">
                                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="12"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4" Margin="10,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" Opacity="0.8">
                                                    <Run Text="{Binding Points}"/><Run Text="{Binding Source={StaticResource Loc}, Path=LabPointsUnit}"/>
                                                </TextBlock>
                                                <Button Content="{Binding Source={StaticResource Loc}, Path=LabHint}" Command="{Binding ToggleHintCommand}"
                                                        Padding="8,2" FontSize="11" IsVisible="{Binding CanShowHint}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Actions ═══ -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=LabStudentName}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding StudentName}" Width="220"/>
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=LabStudentId}" VerticalAlignment="Center" Margin="8,0,0,0"
                           ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=LabStudentIdTip}"/>
                <TextBox Text="{Binding StudentId}" Width="160" ToolTip.Tip="{Binding Source={StaticResource Loc}, Path=LabStudentIdTip}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding Source={StaticResource Loc}, Path=LabRestart}" Command="{Binding RestartCommand}" Padding="12,5"
                        IsVisible="{Binding ShowGrading}"/>
                <Button Content="{Binding Source={StaticResource Loc}, Path=LabExportResult}" Command="{Binding ExportResultCommand}" Padding="12,5"
                        IsVisible="{Binding ShowGrading}"/>
                <Button Content="{Binding Source={StaticResource Loc}, Path=LabSaveSubmission}" Command="{Binding SaveSubmissionCommand}" Padding="12,5"/>
                <Button Content="{Binding Source={StaticResource Loc}, Path=LabCheck}" Command="{Binding CheckCommand}" Padding="16,5"
                        Background="#1E8449" Foreground="White" FontWeight="SemiBold" IsVisible="{Binding CanCheck}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                       Text="{Binding Source={StaticResource Loc}, Path=LabSubmissionNeedName}" IsVisible="{Binding !HasStudentName}"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" FontSize="12" Foreground="#27AE60" TextWrapping="Wrap"
                       Text="{Binding SubmissionStatus}" IsVisible="{Binding HasStudentName}"/>
        </Grid>
    </Grid>
</Window>
