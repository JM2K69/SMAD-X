<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMADX.ViewModels"
        x:Class="SMADX.Views.TierImpactWindow"
        x:DataType="vm:TierImpactViewModel"
        Title="{Binding Source={StaticResource Loc}, Path=TierImpactTitle}"
        Icon="/Assets/icone.ico"
        Width="1150" Height="800"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">

        <!-- ═══ Ce que fait la simulation ═══ -->
        <Border Grid.Row="0" Classes="card" Padding="18,14" Margin="0,0,0,12">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding Source={StaticResource Loc}, Path=ComparisonRefresh}"
                    Command="{Binding RefreshCommand}" Classes="tool" VerticalAlignment="Top" Margin="12,0,0,0"/>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=TierImpactDescription}" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" Text="{Binding Source={StaticResource Loc}, Path=TierImpactNote}" FontSize="11"/>
                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=TierImpactBusy}" IsVisible="{Binding IsBusy}" FontStyle="Italic"/>
            </StackPanel>
        </DockPanel>
        </Border>

        <!-- ═══ Bilan : avant, puis après chaque modèle ═══ -->
        <Border Grid.Row="1" Classes="card" Padding="18,12" Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="360,150,*,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="1" Text="{Binding Source={StaticResource Loc}, Path=TierImpactBefore}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="{Binding FirstModel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="3" Text="{Binding SecondModel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TierImpactRow">
                            <Grid ColumnDefinitions="360,150,*,*" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Before}"/>
                                <TextBlock Grid.Column="2" Text="{Binding First}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding Second}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ═══ Modèle détaillé, migration du domaine ═══ -->
        <DockPanel Grid.Row="2" Margin="2,0,0,10">
            <Button DockPanel.Dock="Right" Content="{Binding Source={StaticResource Loc}, Path=TierImpactMigrate}"
                    Command="{Binding MigrateCommand}" Classes="accent"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" Text="{Binding Source={StaticResource Loc}, Path=TierImpactDetails}" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Impacts}" SelectedItem="{Binding SelectedImpact}" Width="300"/>
                <TextBlock Classes="muted" Text="{Binding DetailSummary}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="3" Classes="card" Padding="12,6,12,8">
        <TabControl Classes="suite">
            <TabItem Header="{Binding Source={StaticResource Loc}, Path=TierImpactPlan}">
                <ListBox Classes="plain" ItemsSource="{Binding Steps}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TierStepItem">
                            <Grid ColumnDefinitions="24,200,*">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ObjectName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding From}" FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding To}" FontFamily="Consolas, Courier New, monospace" FontSize="12"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="{Binding Source={StaticResource Loc}, Path=TierImpactIssues}">
                <ListBox Classes="plain" ItemsSource="{Binding Issues}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="{Binding Source={StaticResource Loc}, Path=TierImpactCutPaths}">
                <ListBox Classes="plain" ItemsSource="{Binding CutPaths}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TierPathItem">
                            <StackPanel>
                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Steps}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="{Binding Source={StaticResource Loc}, Path=TierImpactRemainingPaths}">
                <ListBox Classes="plain" ItemsSource="{Binding RemainingPaths}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TierPathItem">
                            <StackPanel>
                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Steps}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="{Binding Source={StaticResource Loc}, Path=ComparisonFixed}">
                <ListBox Classes="plain" ItemsSource="{Binding FixedFindings}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComparedFinding">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="✔" Foreground="#27AE60" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="{Binding SeverityColor}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="11"/>
                                </Border>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding RuleId}" FontFamily="Consolas, Courier New, monospace"/>
                                    <Run Text=" "/><Run Text="{Binding RuleTitle}" FontWeight="SemiBold"/>
                                    <Run Text=" — "/><Run Text="{Binding ObjectName}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="{Binding Source={StaticResource Loc}, Path=ComparisonNew}">
                <ListBox Classes="plain" ItemsSource="{Binding NewFindings}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComparedFinding">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚠" Foreground="#C0392B" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="{Binding SeverityColor}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="11"/>
                                </Border>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="{Binding RuleId}" FontFamily="Consolas, Courier New, monospace"/>
                                    <Run Text=" "/><Run Text="{Binding RuleTitle}" FontWeight="SemiBold"/>
                                    <Run Text=" — "/><Run Text="{Binding ObjectName}"/>
                                    <Run Text=" : "/><Run Text="{Binding Detail}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
        </Border>
    </Grid>
</Window>
