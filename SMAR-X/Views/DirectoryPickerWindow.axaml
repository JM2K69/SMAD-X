<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMARX.ViewModels"
        x:Class="SMARX.Views.DirectoryPickerWindow"
        x:DataType="vm:DirectoryPickerViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icone.ico"
        Width="680" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <!-- « Sélectionner des utilisateurs ou des groupes » : on coche ; ce qu'Active Directory refuserait est grisé, avec
         sa raison -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" Margin="18">
        <TextBlock Classes="h" Text="{DynamicResource Picker.Title}"/>
        <TextBlock Grid.Row="1" Classes="muted" Text="{DynamicResource Picker.Hint}" TextWrapping="Wrap"/>
        <TextBox Grid.Row="2" Text="{Binding Filter}" PlaceholderText="{DynamicResource Picker.Filter}"/>

        <Border Grid.Row="3" Classes="code" Padding="8,4">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PickerCandidate">
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Reason}" Margin="0,2">
                                <!-- Un TextBlock : en Content, « _ » serait pris pour un raccourci clavier (G_Compta → GCompta) -->
                                <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Panel Width="14" Height="14" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsUser}"/>
                                            <PathIcon Data="{StaticResource GroupIcon}" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding IsGroup}"/>
                                        </Panel>
                                        <TextBlock Text="{Binding Display}" FontSize="13"/>
                                        <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Classes="muted" Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,0"
                                               IsVisible="{Binding !IsEnabled}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Sec.Ok}" Click="OnOk" MinWidth="96" HorizontalContentAlignment="Center"/>
            <Button Content="{DynamicResource Sec.Cancel}" Click="OnCancel" MinWidth="96" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
