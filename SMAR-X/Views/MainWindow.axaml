<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SMARX.ViewModels"
        xmlns:views="using:SMARX.Views"
        x:Class="SMARX.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource App.Title}"
        Icon="/Assets/icone.ico"
        Width="1520" Height="960" MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LinuxWorkspaceViewModel">
            <views:LinuxWorkspaceView/>
        </DataTemplate>
        <DataTemplate DataType="vm:WindowsWorkspaceViewModel">
            <views:WindowsWorkspaceView/>
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <!-- ═══ En-tête ═══ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#4C9AFF" Offset="0"/>
                                <GradientStop Color="#8250DF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Data="{StaticResource ShieldIcon}" Width="20" Height="20" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SMAR-X" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Classes="muted" Text="{DynamicResource App.Subtitle}"/>
                    </StackPanel>
                    <!-- Choix du serveur : Linux ou Windows -->
                    <Border Background="{DynamicResource ChipBg}" CornerRadius="10" Padding="4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ToggleButton Classes="os" IsChecked="{Binding IsLinux}">
                                <StackPanel>
                                    <TextBlock Text="Linux" FontWeight="Bold"/>
                                    <TextBlock Classes="mono" Text="{Binding Linux.Host.Name}" FontSize="11" Opacity="0.8"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="os" IsChecked="{Binding IsWindows}">
                                <StackPanel>
                                    <TextBlock Text="Windows" FontWeight="Bold"/>
                                    <TextBlock Classes="mono" Text="{Binding Windows.Host.Name}" FontSize="11" Opacity="0.8"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="accent" Content="{DynamicResource Button.Labs}" Click="OnLabs"/>
                    <Button Classes="header" Content="{DynamicResource Button.Sample}" Command="{Binding LoadSampleCommand}" IsVisible="{Binding IsFreeMode}"/>
                    <Button Classes="header" Content="{DynamicResource Button.Open}" Click="OnOpen" IsVisible="{Binding IsFreeMode}"/>
                    <Button Classes="header" Content="{DynamicResource Button.Save}" Click="OnSave"/>
                    <Button Classes="header" Content="{DynamicResource Button.Glossary}" Click="OnGlossary"/>
                    <Button Classes="header" Content="{DynamicResource Button.Language}" Command="{Binding ToggleLanguageCommand}"/>
                    <Button Classes="header" Content="{DynamicResource Button.Theme}" Click="OnToggleTheme"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Légende ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock Classes="muted mono" Text="{Binding Legend}"/>
        </Border>

        <ContentControl Content="{Binding Current}"/>
    </DockPanel>
</Window>
