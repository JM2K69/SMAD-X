<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:SMADX.Controls"
        xmlns:vm="using:SMARX.ViewModels"
        xmlns:services="using:SMARX.Services"
        x:Class="SMARX.Views.GlossaryWindow"
        x:DataType="vm:GlossaryViewModel"
        Title="{DynamicResource Glossary.Title}"
        Icon="/Assets/icone.ico"
        Width="1100" Height="820" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.DataTemplates>
        <!-- Une section : titre, introduction, une ligne par abréviation, puis les commandes d'exemple -->
        <DataTemplate DataType="services:GlossarySection">
            <Border Classes="card" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <TextBlock Classes="h" Text="{Binding Title}"/>
                    <TextBlock Classes="muted" Text="{Binding Intro}" TextWrapping="Wrap" IsVisible="{Binding Intro, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="services:GlossaryRow">
                                <Grid ColumnDefinitions="180,260,*,90" ColumnSpacing="12" Margin="0,0,0,8">
                                    <Border Classes="chip" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Classes="mono" Text="{Binding Code}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Meaning}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding Value}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding CommandList}" IsVisible="{Binding HasCommands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="services:GlossaryCommand">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <!-- Ce que fait la commande, puis la commande -->
                                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="13"/>
                                    <!-- Une commande d'un module : l'équivalent icacls à gauche, la commande du module à droite -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasIcacls}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="label" Margin="0" Text="icacls"/>
                                            <Border Classes="code">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <SelectableTextBlock Classes="mono" Text="{Binding Icacls}" FontSize="12" TextWrapping="Wrap"/>
                                                    <ui:CopyButton Grid.Column="1" Text="{Binding Icacls}" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="label" Margin="0" Text="NTFSSecurity"/>
                                            <Border Classes="code">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <SelectableTextBlock Classes="mono" Text="{Binding Command}" FontSize="12" TextWrapping="Wrap"/>
                                                    <ui:CopyButton Grid.Column="1" Text="{Binding Command}" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Border Classes="code" IsVisible="{Binding !HasIcacls}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <SelectableTextBlock Classes="mono" Text="{Binding Command}" FontSize="12" TextWrapping="Wrap"/>
                                            <ui:CopyButton Grid.Column="1" Text="{Binding Command}" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*">
        <!-- L'export : les deux onglets dans un PDF, avec le bouclier de SMAR-X et d'où il vient -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="20,12,20,0">
            <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="accent" Content="{DynamicResource Glossary.ExportPdf}" Click="OnExportPdf"/>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="{Binding Tab}" Margin="16,8">
            <TabItem Header="Windows">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Windows}" Margin="0,8,8,0"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Linux">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Linux}" Margin="0,8,8,0"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
