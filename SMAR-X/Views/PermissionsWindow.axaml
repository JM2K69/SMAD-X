<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:SMADX.Controls"
        xmlns:vm="using:SMARX.ViewModels"
        x:Class="SMARX.Views.PermissionsWindow"
        x:DataType="vm:PermissionsEditViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icone.ico"
        Width="500" Height="720" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <!-- « Autorisations pour … » : la fenêtre du bouton Modifier de l'onglet Sécurité -->
    <Grid RowDefinitions="*,Auto" Margin="18">
        <ScrollViewer>
            <StackPanel Spacing="10" Margin="0,0,6,0">
                <TextBlock Classes="muted">
                    <Run Text="{DynamicResource Sec.ObjectName}"/>
                    <Run Text="{Binding ObjectName}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                </TextBlock>
                <TextBlock Classes="label" Text="{DynamicResource Sec.Names}"/>
                <Border Classes="code" Padding="4">
                    <ListBox ItemsSource="{Binding Principals}" SelectedItem="{Binding SelectedPrincipal}" MaxHeight="170"
                             Background="Transparent" AutoScrollToSelectedItem="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PrincipalItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource GroupIcon}" Width="14" Height="14" IsVisible="{Binding IsGroup}" Foreground="{DynamicResource TextMuted}"/>
                                    <PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14" IsVisible="{Binding IsUser}" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding Display}" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Candidate}" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Content="{DynamicResource Sec.Add}" Command="{Binding AddCommand}"/>
                    <Button Grid.Column="2" Content="{DynamicResource Sec.Remove}" Command="{Binding RemoveCommand}"/>
                </Grid>
                <Border Classes="chip" CornerRadius="8" Padding="12,8" IsVisible="{Binding HasMessage}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="{Binding MessageBrush}"/>
                </Border>

                <Grid ColumnDefinitions="*,74,74" Margin="10,6,10,0">
                    <TextBlock Classes="label" Text="{Binding PermissionsFor}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Classes="label" Text="{DynamicResource Sec.Allow}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                    <TextBlock Grid.Column="2" Classes="label" Text="{DynamicResource Sec.Deny}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                </Grid>
                <Border Classes="code" Padding="10,4">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditRowItem">
                                <!-- Pas de texte dans les cases : Avalonia y prendrait « _ » pour un raccourci -->
                                <Grid ColumnDefinitions="*,74,74">
                                    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AllowChecked}" IsEnabled="{Binding AllowEnabled}" HorizontalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding DenyChecked}" IsEnabled="{Binding DenyEnabled}" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Classes="muted" Text="{DynamicResource Sec.Legend}"/>

                <TextBlock Classes="label" Text="{DynamicResource Sec.Equivalent}" Margin="0,6,0,0"/>
                <Border Classes="code">
                    <Grid ColumnDefinitions="*,Auto">
                        <SelectableTextBlock Classes="mono" Text="{Binding Commands}" FontSize="11" TextWrapping="Wrap"/>
                        <ui:CopyButton Grid.Column="1" Text="{Binding Commands}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="{DynamicResource Sec.Ok}" Click="OnOk" MinWidth="96" HorizontalContentAlignment="Center"/>
            <Button Content="{DynamicResource Sec.Cancel}" Click="OnCancel" MinWidth="96" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
